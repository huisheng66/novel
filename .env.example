# codexnovel 环境变量示例
# 复制为 .env 并按实际填写。生产环境建议用部署脚本 scripts/deploy-ubuntu.sh 自动生成。

# ===== 应用 =====
PORT=3008
# HTTP 明文端口绑定地址;127.0.0.1=仅本机调试,局域网/公网访问走 HTTPS(PORT+435)
HTTP_HOST=127.0.0.1
NODE_ENV=production

# ===== 后台管理员 =====
# 必填,无默认值;缺失时服务拒绝启动。请使用随机强口令,如: openssl rand -hex 16
ADMIN_PASSWORD=
# 必填,会话签名密钥,同样必须随机独立生成,如: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=novel_app
DB_PASSWORD=
DB_NAME=novel
# 连接池上限，建议不超过 MySQL max_connections 的 50%
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0

# ===== 缓存 =====
# 前台 HTML 渲染缓存 TTL（毫秒）
PUBLIC_CACHE_TTL_MS=10000

# ===== 访问统计队列 =====
# 批量入库每批最大条数
PAGE_VIEW_BATCH_SIZE=100
# 批量入库刷新间隔（毫秒）
PAGE_VIEW_FLUSH_INTERVAL_MS=1000
