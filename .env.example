# codexnovel 环境变量示例
# 复制为 .env 并按实际填写。生产环境建议用部署脚本 scripts/deploy-ubuntu.sh 自动生成。

# ===== 应用 =====
PORT=3008
NODE_ENV=production

# ===== 后台管理员 =====
# 生产环境必须设置强随机密码（≥12 位），禁止使用默认值；代码在 NODE_ENV=production 时拒绝默认密码
ADMIN_PASSWORD=请设置强随机密码
# 会话签名密钥：必须设置独立的强随机值（生产强制）；不能与 ADMIN_PASSWORD 相同
ADMIN_SESSION_SECRET=请设置强随机密钥

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=novel_app
DB_PASSWORD=
DB_NAME=novel
# 连接池上限，建议不超过 MySQL max_connections 的 50%
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0

# ===== 缓存 =====
# 前台 HTML 渲染缓存 TTL（毫秒），生产建议 300000～900000
PUBLIC_CACHE_TTL_MS=300000
# Access Token 鉴权缓存 TTL（毫秒）
ACCESS_TOKEN_CACHE_TTL_MS=120000

# ===== 访问统计队列 =====
# 批量入库每批最大条数
PAGE_VIEW_BATCH_SIZE=100
# 批量入库刷新间隔（毫秒）
PAGE_VIEW_FLUSH_INTERVAL_MS=1000

# ===== 官方 App API (/api/v1) =====
# JWT 签名密钥：必填，≥32 字节随机值；代码在缺失/过短时拒绝启动（不再回退到 ADMIN_PASSWORD）
JWT_ACCESS_SECRET=请设置≥32字节随机密钥
# Access JWT 有效期（秒），默认 2 小时
JWT_ACCESS_TTL_SEC=7200
# Refresh Token 有效天数
JWT_REFRESH_TTL_DAYS=30
# 是否允许自助注册（邮箱 + 密码即可；邀请码为选填，不做强制）
API_REGISTER_ENABLED=true
# 登录/注册/刷新：窗口内最大次数（默认 30 / 15 分钟）
API_RATE_LIMIT_AUTH_MAX=30
API_RATE_LIMIT_AUTH_WINDOW_MS=900000
# 章节正文：默认 180 / 分钟
API_RATE_LIMIT_CHAPTER_MAX=180
API_RATE_LIMIT_CHAPTER_WINDOW_MS=60000
# 进度 batch：默认 60 / 分钟
API_RATE_LIMIT_PROGRESS_BATCH_MAX=60
API_RATE_LIMIT_PROGRESS_BATCH_WINDOW_MS=60000
# 写运营配置 PUT /api/v1/ops 的密钥：建议设置独立强随机值（不再建议留空回退）
API_OPS_ADMIN_KEY=请设置独立强随机密钥

# ===== 反向代理与安全 =====
# 部署在 nginx/CDN 后时设 true，Express 才会信任 X-Forwarded-For（限流按真实对端 IP）
# 默认 false：限流/风控按 socket 对端地址计数，客户端无法伪造绕过
TRUST_PROXY=false
# 可信 Host 白名单（逗号分隔）。配置后 getBaseUrl 只返回白名单 host，防 Host 头投毒
# 未配置时 HTML 缓存已按 Host 隔离，同样不受跨用户投毒影响
ALLOWED_HOSTS=

# ===== 可选：SMTP 邮件（邮箱验证 / 找回密码）=====
# 未配置时不发信：验证与重置链接会写入服务端日志，可手动复制给用户。
# 配置示例（QQ 邮箱 / 企业邮箱 / SendGrid 等均可）：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_SECURE=1          # 465 端口用 1；587 端口保持 0（STARTTLS）
#   SMTP_USER=you@qq.com
#   SMTP_PASS=授权码（不是登录密码）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# 发件人显示地址，留空则用 SMTP_USER
MAIL_FROM=
# 邮件里链接用的站点地址，例如 https://novel.example.com（强烈建议设置）
PUBLIC_BASE_URL=
# 邮件里显示的站点名
SITE_NAME=书库

# ===== 可选：Redis（多实例共享状态）=====
# 不配置时全部状态留在进程内存，单实例部署无需 Redis。
# 配置后：① 限流计数跨实例共享 ② 缓存失效广播到其他实例（避免多实例下读到旧页面）
# 示例：redis://127.0.0.1:6379  或  redis://:password@host:6379/0
# 注意：Redis 不可用时自动降级为进程内状态，不会导致服务启动失败。
REDIS_URL=
