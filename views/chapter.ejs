<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= novel.title %> <%= chapter.readerTitle || chapter.title %> 正文">
  <title><%= chapter.readerTitle || chapter.title %>｜<%= novel.title %></title>
  <link rel="canonical" href="<%= baseUrl %>/novel/<%= novel.id %>/<%= chapter.chapter_number %>">
  <meta property="og:title" content="<%= chapter.readerTitle || chapter.title %> - <%= novel.title %>">
  <meta property="og:description" content="<%= novel.description || novel.title %>">
  <meta property="og:type" content="article">
  <meta property="og:url" content="<%= baseUrl %>/novel/<%= novel.id %>/<%= chapter.chapter_number %>">
  <% if (novel.cover_image) { %>
    <meta property="og:image" content="<%= novel.cover_image.startsWith('http') ? novel.cover_image : baseUrl + novel.cover_image %>">
  <% } %>
  <link rel="stylesheet" href="/css/main.css?v=20261102c">
  <link rel="stylesheet" href="/css/reader-settings-modal.css?v=20261102c">
  <link rel="stylesheet" href="/css/feedback-modal.css?v=20261102d">
  <script src="/js/site.js?v=20261031a" defer></script>
  <script>
    (function () {
      try {
        var theme = localStorage.getItem('reader-theme');
        if (theme) document.documentElement.setAttribute('data-reader-theme', theme);
        var fontSize = localStorage.getItem('reader-font-size');
        if (fontSize) document.documentElement.style.setProperty('--reader-font-size', fontSize);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <%- include('partials/site-header', { currentPage: 'library', breadcrumb: novel.title, isReaderPage: true }) %>

  <main id="main-content">
    <div class="reader-chrome">
      <nav class="chapter-navigation chapter-navigation-top" aria-label="章节导航">
        <% if (prevChapter) { %>
          <a href="/novel/<%= novel.id %>/<%= prevChapter.chapter_number %>" rel="prev" class="nav-prev" title="<%= prevChapter.title %>"><span aria-hidden="true">←</span> 上一章</a>
        <% } else { %>
          <span class="nav-placeholder" aria-label="没有上一章">已是第一章</span>
        <% } %>
        <a href="/novel/<%= novel.id %>" class="nav-toc">返回目录</a>
        <% if (nextChapter) { %>
          <a href="/novel/<%= novel.id %>/<%= nextChapter.chapter_number %>" rel="next" class="nav-next" title="<%= nextChapter.title %>">下一章 <span aria-hidden="true">→</span></a>
        <% } else { %>
          <span class="nav-placeholder" aria-label="没有下一章">已是最新章</span>
        <% } %>
      </nav>
    </div>

    <article class="content_read" id="wrapper" aria-labelledby="chapter-heading">
      <div class="box_con chapter-content">
        <header class="bookname chapter-header">
          <h1 id="chapter-heading"><%= chapter.readerTitle || chapter.title %></h1>
        </header>
        <div id="content" class="chapter-body content showtxt entry-content" itemprop="articleBody">
          <% chapter.paragraphs.forEach(function(p) { %><p><%= p %></p><% }) %>
        </div>
      </div>
    </article>

    <nav class="chapter-navigation chapter-navigation-bottom reader-chrome bottem2" aria-label="章节导航">
      <% if (prevChapter) { %>
        <a href="/novel/<%= novel.id %>/<%= prevChapter.chapter_number %>" rel="prev" class="nav-prev" title="<%= prevChapter.title %>"><span aria-hidden="true">←</span> 上一章</a>
      <% } else { %>
        <span class="nav-placeholder">已是第一章</span>
      <% } %>
      <a href="/novel/<%= novel.id %>" class="nav-toc">返回目录</a>
      <% if (nextChapter) { %>
        <a href="/novel/<%= novel.id %>/<%= nextChapter.chapter_number %>" rel="next" class="nav-next" title="<%= nextChapter.title %>">下一章 <span aria-hidden="true">→</span></a>
      <% } else { %>
        <span class="nav-placeholder">已是最新章</span>
      <% } %>
    </nav>
    <p class="reader-keyboard-hint">键盘左右方向键也可以切换章节</p>
  </main>

  <footer id="site-footer" class="reader-chrome"><p><a href="/novel/<%= novel.id %>">查看《<%= novel.title %>》完整目录</a></p></footer>

  <!-- 返回顶部按钮 -->
  <button class="back-to-top" id="back-to-top" type="button" aria-label="返回顶部" hidden>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 5l-7 7h4v7h6v-7h4z" fill="currentColor"/></svg>
  </button>

  <!-- 阅读设置模态框 -->
  <div class="reader-settings-overlay" id="reader-settings-overlay"></div>
  <div class="reader-settings-modal" id="reader-settings-modal">
    <div class="reader-settings-header">
      <h2 class="reader-settings-title">阅读设置</h2>
      <button class="reader-settings-close" id="reader-settings-close" type="button" aria-label="关闭设置">×</button>
    </div>
    <div class="reader-settings-body">
      <div class="reader-setting-group">
        <div class="reader-setting-label">字体</div>
        <div class="reader-setting-options" id="font-family-options">
          <button class="reader-setting-btn" data-font="serif" type="button">宋体</button>
          <button class="reader-setting-btn" data-font="sans" type="button">黑体</button>
          <button class="reader-setting-btn" data-font="kai" type="button">楷体</button>
        </div>
      </div>

      <div class="reader-setting-group">
        <div class="reader-setting-label">字号</div>
        <div class="font-size-control">
          <span class="font-size-label" id="font-size-label">标准</span>
          <input type="range" class="font-size-slider" id="font-size-slider" min="14" max="22" step="1" value="17">
        </div>
      </div>

      <div class="reader-setting-group">
        <div class="reader-setting-label">背景色</div>
        <div class="reader-setting-options" id="bg-color-options">
          <button class="reader-setting-btn bg-color-option" data-bg="default" type="button" aria-label="默认"></button>
          <button class="reader-setting-btn bg-color-option" data-bg="warm" type="button" aria-label="护眼"></button>
          <button class="reader-setting-btn bg-color-option" data-bg="cool" type="button" aria-label="清凉"></button>
          <button class="reader-setting-btn bg-color-option" data-bg="dark" type="button" aria-label="深色"></button>
        </div>
      </div>

      <div class="reader-setting-group">
        <div class="reader-setting-label">行距</div>
        <div class="line-height-control">
          <span class="line-height-label" id="line-height-label">标准</span>
          <input type="range" class="line-height-slider" id="line-height-slider" min="1.3" max="2.2" step="0.1" value="1.7">
        </div>
      </div>
    </div>
  </div>

  <!-- 反馈模态框 -->
  <div class="feedback-overlay" id="feedback-overlay"></div>
  <div class="feedback-modal" id="feedback-modal">
    <div class="feedback-header">
      <h2 class="feedback-title">用户反馈</h2>
      <button class="feedback-close" id="feedback-close" type="button" aria-label="关闭">×</button>
    </div>
    <div class="feedback-status" id="feedback-status"></div>
    <form class="feedback-form" id="feedback-form">
      <div class="feedback-field">
        <label class="feedback-label" for="feedback-email">
          邮箱 <span class="optional">(选填，用于接收回复)</span>
        </label>
        <input
          type="email"
          class="feedback-input"
          id="feedback-email"
          placeholder="your@email.com"
          autocomplete="email"
        >
      </div>
      <div class="feedback-field">
        <label class="feedback-label" for="feedback-content">
          反馈内容 <span style="color: #d32f2f;">*</span>
        </label>
        <textarea
          class="feedback-textarea"
          id="feedback-content"
          placeholder="请描述您遇到的问题或建议..."
          required
        ></textarea>
      </div>
      <div class="feedback-actions">
        <button type="button" class="feedback-btn feedback-btn-cancel" id="feedback-cancel">取消</button>
        <button type="submit" class="feedback-btn feedback-btn-submit" id="feedback-submit">提交</button>
      </div>
    </form>
  </div>

  <script>
    (function () {
      var html = document.documentElement;
      var syncStatus = null; // 旧设置区域已删除

      function storageGet(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
      function storageSet(key, value) { try { localStorage.setItem(key, value); } catch (e) {} }

      // 阅读设置模态框
      var settingsTrigger = document.getElementById('reader-settings-trigger');
      var settingsModal = document.getElementById('reader-settings-modal');
      var settingsOverlay = document.getElementById('reader-settings-overlay');
      var settingsClose = document.getElementById('reader-settings-close');

      function openSettings() {
        settingsOverlay.classList.add('is-visible');
        settingsModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      function closeSettings() {
        settingsOverlay.classList.remove('is-visible');
        settingsModal.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      if (settingsTrigger) {
        settingsTrigger.addEventListener('click', openSettings);
      }
      if (settingsClose) {
        settingsClose.addEventListener('click', closeSettings);
      }
      if (settingsOverlay) {
        settingsOverlay.addEventListener('click', closeSettings);
      }
      // 字体设置
      var fontBtns = document.querySelectorAll('#font-family-options .reader-setting-btn');
      var currentFont = storageGet('reader-font-family') || 'serif';
      fontBtns.forEach(function (btn) {
        if (btn.getAttribute('data-font') === currentFont) {
          btn.classList.add('is-active');
        }
        btn.addEventListener('click', function () {
          var font = this.getAttribute('data-font');
          fontBtns.forEach(function (b) { b.classList.remove('is-active'); });
          this.classList.add('is-active');
          if (font === 'serif') {
            html.style.fontFamily = '"Noto Serif SC", "Source Han Serif SC", Georgia, "Songti SC", serif';
          } else if (font === 'sans') {
            html.style.fontFamily = '-apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif';
          } else if (font === 'kai') {
            html.style.fontFamily = '"KaiTi", "Kaiti SC", STKaiti, "STKaiti", serif';
          }
          storageSet('reader-font-family', font);
        });
      });
      // 应用已保存字体
      if (currentFont === 'sans') {
        html.style.fontFamily = '-apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif';
      } else if (currentFont === 'kai') {
        html.style.fontFamily = '"KaiTi", "Kaiti SC", STKaiti, "STKaiti", serif';
      }

      // 字号设置 - 滑块（只影响正文）
      var fontSizeSlider = document.getElementById('font-size-slider');
      var fontSizeLabel = document.getElementById('font-size-label');
      var chapterBody = document.querySelector('.chapter-body');
      var savedFontSize = storageGet('reader-font-size-px');
      if (savedFontSize && chapterBody) {
        fontSizeSlider.value = savedFontSize;
        chapterBody.style.fontSize = savedFontSize + 'px';
        fontSizeLabel.textContent = savedFontSize + 'px';
      }
      fontSizeSlider.addEventListener('input', function () {
        var size = this.value;
        if (chapterBody) {
          chapterBody.style.fontSize = size + 'px';
        }
        fontSizeLabel.textContent = size + 'px';
        storageSet('reader-font-size-px', size);
      });

      // 背景色设置
      var bgBtns = document.querySelectorAll('#bg-color-options .reader-setting-btn');
      var currentBg = storageGet('reader-bg-color') || 'default';
      bgBtns.forEach(function (btn) {
        if (btn.getAttribute('data-bg') === currentBg) {
          btn.classList.add('is-active');
        }
        btn.addEventListener('click', function () {
          var bg = this.getAttribute('data-bg');
          bgBtns.forEach(function (b) { b.classList.remove('is-active'); });
          this.classList.add('is-active');
          html.setAttribute('data-reader-bg', bg);
          storageSet('reader-bg-color', bg);
        });
      });
      // 应用已保存背景色
      if (currentBg) {
        html.setAttribute('data-reader-bg', currentBg);
      }

      // 行距设置 - 滑块（只影响正文）
      var lineHeightSlider = document.getElementById('line-height-slider');
      var lineHeightLabel = document.getElementById('line-height-label');
      var savedLineHeight = storageGet('reader-line-height');
      if (savedLineHeight && chapterBody) {
        lineHeightSlider.value = savedLineHeight;
        chapterBody.style.lineHeight = savedLineHeight;
        lineHeightLabel.textContent = savedLineHeight;
      }
      lineHeightSlider.addEventListener('input', function () {
        var lh = this.value;
        if (chapterBody) {
          chapterBody.style.lineHeight = lh;
        }
        lineHeightLabel.textContent = lh;
        storageSet('reader-line-height', lh);
      });

      var novelId = <%= novel.id %>;
      var chapterNumber = <%= chapter.chapter_number %>;
      var progressKey = 'reading-progress:' + novelId + ':' + chapterNumber;
      var progressMetaKey = 'reading-progress-meta:' + novelId;
      var apiTokenKey = 'codexnovel_access_token';
      function getApiToken() { return storageGet(apiTokenKey) || ''; }

      function currentOffsetRatio() {
        // 使用 visualViewport API 避免移动端键盘影响
        var viewport = window.visualViewport || window;
        var viewportHeight = viewport.height || window.innerHeight;
        var max = document.documentElement.scrollHeight - viewportHeight;
        return max <= 0 ? 0 : Math.min(1, Math.max(0, window.scrollY / max));
      }
      function applyOffsetRatio(ratio) {
        var value = parseFloat(ratio);
        if (!(value > 0)) return;
        requestAnimationFrame(function () {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          if (max > 0) window.scrollTo(0, max * value);
        });
      }
      function saveLocalProgress(ratio) {
        storageSet(progressKey, String(ratio));
        storageSet(progressMetaKey, JSON.stringify({ chapterNumber: chapterNumber, offsetRatio: ratio, updatedAt: new Date().toISOString() }));
      }
      function syncProgressToCloud(ratio) {
        var token = getApiToken();
        if (!token) return;
        fetch('/api/v1/me/progress', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token, 'Accept': 'application/json' },
          body: JSON.stringify({ novelId: novelId, chapterNumber: chapterNumber, offsetRatio: ratio, updatedAt: new Date().toISOString(), deviceName: 'web' }),
          credentials: 'same-origin'
        }).catch(function () {});
      }

      applyOffsetRatio(parseFloat(storageGet(progressKey)));
      (function pullCloudProgress() {
        var token = getApiToken();
        if (!token) return;
        fetch('/api/v1/me/progress/' + novelId, {
          headers: { 'Authorization': 'Bearer ' + token, 'Accept': 'application/json' }, credentials: 'same-origin'
        }).then(function (response) {
          if (response.status === 404 || !response.ok) return null;
          return response.json();
        }).then(function (data) {
          if (!data || data.chapterNumber == null) return;
          var localMeta = null;
          try { localMeta = JSON.parse(storageGet(progressMetaKey) || 'null'); } catch (e) {}
          var localTs = localMeta && localMeta.updatedAt ? Date.parse(localMeta.updatedAt) : 0;
          var cloudTs = data.updatedAt ? Date.parse(data.updatedAt) : 0;
          if (!cloudTs || (localTs && localTs >= cloudTs)) return;
          storageSet(progressMetaKey, JSON.stringify({ chapterNumber: data.chapterNumber, offsetRatio: data.offsetRatio, updatedAt: data.updatedAt }));
          if (Number(data.chapterNumber) === chapterNumber) {
            applyOffsetRatio(data.offsetRatio);
            storageSet(progressKey, String(data.offsetRatio || 0));
          }
        }).catch(function () {});
      })();

      var saveTimer = null;
      var isKeyboardOpen = false;

      // 监听视口变化（键盘弹起/收起）
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', function () {
          // 键盘弹起/收起时暂停进度保存
          isKeyboardOpen = true;
          clearTimeout(saveTimer);
          setTimeout(function () { isKeyboardOpen = false; }, 300);
        });
      }

      window.addEventListener('scroll', function () {
        // 键盘弹起时不保存进度
        if (isKeyboardOpen) return;
        clearTimeout(saveTimer);
        saveTimer = setTimeout(function () {
          var ratio = currentOffsetRatio();
          saveLocalProgress(ratio);
          syncProgressToCloud(ratio);
        }, 500);
      }, { passive: true });

      document.addEventListener('keydown', function (event) {
        var tag = event.target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || event.target.isContentEditable) return;
        if (event.key === 'ArrowLeft') {
          var prev = document.querySelector('a[rel="prev"]');
          if (prev) window.location.href = prev.href;
        } else if (event.key === 'ArrowRight') {
          var next = document.querySelector('a[rel="next"]');
          if (next) window.location.href = next.href;
        }
      });

      // 返回顶部按钮
      var backToTopBtn = document.getElementById('back-to-top');
      var backShown = false;
      var backScrollRaf = 0;
      function updateBackButton() {
        backScrollRaf = 0;
        var shouldShow = window.scrollY > 500;
        if (shouldShow === backShown) return;
        backShown = shouldShow;
        backToTopBtn.hidden = !shouldShow;
        backToTopBtn.classList.toggle('is-visible', shouldShow);
      }

      function handleScroll() {
        if (!backScrollRaf) backScrollRaf = requestAnimationFrame(updateBackButton);
      }

      window.addEventListener('scroll', handleScroll, { passive: true });

      backToTopBtn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });

      // 阅读设置模态框
      var settingsTrigger = document.getElementById('reader-settings-trigger');
      var settingsModal = document.getElementById('reader-settings-modal');
      var settingsOverlay = document.getElementById('reader-settings-overlay');
      var settingsClose = document.getElementById('reader-settings-close');

      function openSettings() {
        settingsOverlay.classList.add('is-visible');
        settingsModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      function closeSettings() {
        settingsOverlay.classList.remove('is-visible');
        settingsModal.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      if (settingsTrigger) {
        settingsTrigger.addEventListener('click', openSettings);
      }
      settingsClose.addEventListener('click', closeSettings);
      settingsOverlay.addEventListener('click', closeSettings);

      // 反馈模态框
      var feedbackTrigger = document.getElementById('feedback-trigger');
      var feedbackModal = document.getElementById('feedback-modal');
      var feedbackOverlay = document.getElementById('feedback-overlay');
      var feedbackClose = document.getElementById('feedback-close');
      var feedbackCancel = document.getElementById('feedback-cancel');
      var feedbackForm = document.getElementById('feedback-form');
      var feedbackStatus = document.getElementById('feedback-status');

      function openFeedback() {
        feedbackOverlay.classList.add('active');
        feedbackModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeFeedback() {
        feedbackOverlay.classList.remove('active');
        feedbackModal.classList.remove('active');
        document.body.style.overflow = '';
        feedbackStatus.className = 'feedback-status';
        feedbackStatus.textContent = '';
      }

      if (feedbackTrigger) {
        feedbackTrigger.addEventListener('click', openFeedback);
      }
      feedbackClose.addEventListener('click', closeFeedback);
      feedbackCancel.addEventListener('click', closeFeedback);
      feedbackOverlay.addEventListener('click', closeFeedback);

      feedbackForm.addEventListener('submit', function (e) {
        e.preventDefault();

        var email = document.getElementById('feedback-email').value.trim();
        var content = document.getElementById('feedback-content').value.trim();
        var submitBtn = document.getElementById('feedback-submit');

        if (!content) {
          feedbackStatus.className = 'feedback-status error';
          feedbackStatus.textContent = '请填写反馈内容';
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = '提交中...';
        feedbackStatus.className = 'feedback-status';
        feedbackStatus.textContent = '';

        fetch('/api/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, content: content })
        })
        .then(function (res) {
          if (!res.ok) throw new Error('提交失败');
          return res.json();
        })
        .then(function () {
          feedbackStatus.className = 'feedback-status success';
          feedbackStatus.textContent = '提交成功，感谢您的反馈！';
          feedbackForm.reset();
          setTimeout(closeFeedback, 2000);
        })
        .catch(function (err) {
          feedbackStatus.className = 'feedback-status error';
          feedbackStatus.textContent = err.message || '提交失败，请稍后重试';
        })
        .finally(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = '提交';
        });
      });

      // 字体设置
      var fontBtns = document.querySelectorAll('#font-family-options .reader-setting-btn');
      var currentFont = storageGet('reader-font-family') || 'serif';
      fontBtns.forEach(function (btn) {
        if (btn.getAttribute('data-font') === currentFont) {
          btn.classList.add('is-active');
        }
        btn.addEventListener('click', function () {
          var font = this.getAttribute('data-font');
          fontBtns.forEach(function (b) { b.classList.remove('is-active'); });
          this.classList.add('is-active');
          if (font === 'serif') {
            html.style.fontFamily = '"Noto Serif SC", "Source Han Serif SC", Georgia, "Songti SC", serif';
          } else if (font === 'sans') {
            html.style.fontFamily = '-apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif';
          } else if (font === 'kai') {
            html.style.fontFamily = '"KaiTi", "Kaiti SC", STKaiti, "STKaiti", serif';
          }
          storageSet('reader-font-family', font);
        });
      });
      // 应用已保存字体
      if (currentFont === 'sans') {
        html.style.fontFamily = '-apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif';
      } else if (currentFont === 'kai') {
        html.style.fontFamily = '"KaiTi", "Kaiti SC", STKaiti, "STKaiti", serif';
      }

      // 字号设置（复用已有逻辑）
      var sizeBtns = document.querySelectorAll('#font-size-options .reader-setting-btn');
      var currentSizeIndex = getFontIndex();
      sizeBtns.forEach(function (btn, index) {
        if (index === currentSizeIndex) {
          btn.classList.add('is-active');
        }
        btn.addEventListener('click', function () {
          var size = this.getAttribute('data-size');
          var index = fontSizes.indexOf(size);
          if (index >= 0) {
            applyFont(index);
            sizeBtns.forEach(function (b) { b.classList.remove('is-active'); });
            this.classList.add('is-active');
          }
        });
      });

      // 行距设置
      var lhBtns = document.querySelectorAll('#line-height-options .reader-setting-btn');
      var currentLh = storageGet('reader-line-height') || '1.7';
      lhBtns.forEach(function (btn) {
        if (btn.getAttribute('data-lh') === currentLh) {
          btn.classList.add('is-active');
        }
        btn.addEventListener('click', function () {
          var lh = this.getAttribute('data-lh');
          lhBtns.forEach(function (b) { b.classList.remove('is-active'); });
          this.classList.add('is-active');
          html.style.lineHeight = lh;
          storageSet('reader-line-height', lh);
        });
      });
      // 应用已保存行距
      if (currentLh) {
        html.style.lineHeight = currentLh;
      }
    })();
  </script>
</body>
</html>
