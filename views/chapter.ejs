<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= novel.title %> <%= chapter.readerTitle || chapter.title %> 正文">
  <title><%= chapter.readerTitle || chapter.title %>_<%= novel.title %></title>
  <link rel="canonical" href="<%= baseUrl %>/novel/<%= novel.id %>/<%= chapter.chapter_number %>">
  <meta property="og:title" content="<%= chapter.readerTitle || chapter.title %> - <%= novel.title %>">
  <meta property="og:description" content="<%= novel.description || novel.title %>">
  <meta property="og:type" content="article">
  <meta property="og:url" content="<%= baseUrl %>/novel/<%= novel.id %>/<%= chapter.chapter_number %>">
  <% if (novel.cover_image) { %>
    <meta property="og:image" content="<%= novel.cover_image.startsWith('http') ? novel.cover_image : baseUrl + novel.cover_image %>">
  <% } %>
  <link rel="stylesheet" href="/css/main.css?v=20260807f">
  <script>
    (function() {
      var theme = localStorage.getItem('reader-theme');
      if (theme) document.documentElement.setAttribute('data-reader-theme', theme);
      var fontSize = localStorage.getItem('reader-font-size');
      if (fontSize) document.documentElement.style.setProperty('--reader-font-size', fontSize);
    })();
  </script>
</head>
<body>
  <header id="site-header" class="reader-chrome">
    <div class="header-inner">
      <span class="header-crumbs">
        <a href="/novel/<%= novel.id %>"><%= novel.title %></a>
        <span class="breadcrumb"> / </span>
        <span class="breadcrumb-current"><%= chapter.readerTitle || chapter.title %></span>
      </span>
      <a class="header-shelf" href="/" title="返回书架" id="header-shelf">书架</a>
    </div>
  </header>

  <main>
    <div class="reader-chrome">
      <div class="reader-controls">
        <button class="reader-btn" id="theme-toggle" type="button">深色</button>
        <span class="reader-font-label">字号</span>
        <button class="reader-btn" id="font-decrease" type="button">A-</button>
        <button class="reader-btn" id="font-increase" type="button">A+</button>
      </div>

      <nav class="chapter-navigation chapter-navigation-top" aria-label="章节导航">
        <% if (prevChapter) { %>
          <a href="/novel/<%= novel.id %>/<%= prevChapter.chapter_number %>"
             rel="prev" class="nav-prev" title="<%= prevChapter.title %>">
            &larr; 上一章
          </a>
        <% } else { %>
          <span class="nav-placeholder"></span>
        <% } %>
        <a href="/novel/<%= novel.id %>" class="nav-toc">目录</a>
        <% if (nextChapter) { %>
          <a href="/novel/<%= novel.id %>/<%= nextChapter.chapter_number %>"
             rel="next" class="nav-next" title="<%= nextChapter.title %>">
            下一章 &rarr;
          </a>
        <% } else { %>
          <span class="nav-placeholder"></span>
        <% } %>
      </nav>
    </div>

    <%# 结构贴近常见小说站，便于夸克/UC 阅读模式识别：#content + 第N章 标题 + 连续长段落 %>
    <div class="content_read" id="wrapper">
      <div class="box_con chapter-content">
        <div class="bookname chapter-header">
          <h1 id="chapter-heading"><%= chapter.readerTitle || chapter.title %></h1>
          <% if (chapter.title && chapter.readerTitle && chapter.title !== chapter.readerTitle) { %>
            <p class="chapter-meta"><%= chapter.title %></p>
          <% } %>
        </div>

        <div id="content" class="chapter-body content showtxt entry-content" itemprop="articleBody">
          <% chapter.paragraphs.forEach(function(p) { %>
            <p><%= p %></p>
          <% }) %>
        </div>
      </div>
    </div>

    <nav class="chapter-navigation chapter-navigation-bottom reader-chrome bottem2" aria-label="章节导航">
      <% if (prevChapter) { %>
        <a href="/novel/<%= novel.id %>/<%= prevChapter.chapter_number %>"
           rel="prev" class="nav-prev" title="<%= prevChapter.title %>">
          &larr; 上一章
        </a>
      <% } else { %>
        <span class="nav-placeholder"></span>
      <% } %>
      <a href="/novel/<%= novel.id %>" class="nav-toc">目录</a>
      <% if (nextChapter) { %>
        <a href="/novel/<%= novel.id %>/<%= nextChapter.chapter_number %>"
           rel="next" class="nav-next" title="<%= nextChapter.title %>">
          下一章 &rarr;
        </a>
      <% } else { %>
        <span class="nav-placeholder"></span>
      <% } %>
    </nav>
  </main>

  <footer id="site-footer" class="reader-chrome">
    <p></p>
  </footer>

  <script>
    (function() {
      var html = document.documentElement;
      var themeBtn = document.getElementById('theme-toggle');
      var fontDecBtn = document.getElementById('font-decrease');
      var fontIncBtn = document.getElementById('font-increase');

      function currentTheme() {
        return html.getAttribute('data-reader-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      }
      function updateThemeLabel() {
        themeBtn.textContent = currentTheme() === 'dark' ? '浅色' : '深色';
      }
      themeBtn.addEventListener('click', function() {
        var next = currentTheme() === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-reader-theme', next);
        localStorage.setItem('reader-theme', next);
        updateThemeLabel();
      });

      var fontSizes = ['0.95rem', '1.0625rem', '1.2rem', '1.35rem'];
      var defaultIdx = 1;
      function getFontIndex() {
        var idx = fontSizes.indexOf(localStorage.getItem('reader-font-size'));
        return idx >= 0 ? idx : defaultIdx;
      }
      function applyFont(idx) {
        html.style.setProperty('--reader-font-size', fontSizes[idx]);
        localStorage.setItem('reader-font-size', fontSizes[idx]);
      }
      fontDecBtn.addEventListener('click', function() {
        var idx = getFontIndex();
        if (idx > 0) applyFont(idx - 1);
      });
      fontIncBtn.addEventListener('click', function() {
        var idx = getFontIndex();
        if (idx < fontSizes.length - 1) applyFont(idx + 1);
      });

      updateThemeLabel();

      var novelId = <%= novel.id %>;
      var chapterNumber = <%= chapter.chapter_number %>;
      var progressKey = 'reading-progress:' + novelId + ':' + chapterNumber;
      var progressMetaKey = 'reading-progress-meta:' + novelId;
      var apiTokenKey = 'codexnovel_access_token';

      function currentOffsetRatio() {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        if (max <= 0) return 0;
        return Math.min(1, Math.max(0, window.scrollY / max));
      }

      function applyOffsetRatio(ratio) {
        var r = parseFloat(ratio);
        if (!(r > 0)) return;
        requestAnimationFrame(function() {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          if (max > 0) window.scrollTo(0, max * r);
        });
      }

      function saveLocalProgress(ratio) {
        localStorage.setItem(progressKey, String(ratio));
        try {
          localStorage.setItem(progressMetaKey, JSON.stringify({
            chapterNumber: chapterNumber,
            offsetRatio: ratio,
            updatedAt: new Date().toISOString()
          }));
        } catch (e) { /* ignore quota */ }
      }

      function getApiToken() {
        try { return localStorage.getItem(apiTokenKey) || ''; } catch (e) { return ''; }
      }

      function syncProgressToCloud(ratio) {
        var token = getApiToken();
        if (!token) return;
        var body = {
          novelId: novelId,
          chapterNumber: chapterNumber,
          offsetRatio: ratio,
          updatedAt: new Date().toISOString(),
          deviceName: 'web'
        };
        fetch('/api/v1/me/progress', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token,
            'Accept': 'application/json'
          },
          body: JSON.stringify(body),
          credentials: 'same-origin'
        }).catch(function() { /* 离线静默 */ });
      }

      // 1) 先用本地进度
      var saved = parseFloat(localStorage.getItem(progressKey));
      applyOffsetRatio(saved);

      // 2) 若有 App/Web JWT，拉云端进度并 LWW（同书维度）
      (function pullCloudProgress() {
        var token = getApiToken();
        if (!token) return;
        fetch('/api/v1/me/progress/' + novelId, {
          headers: { 'Authorization': 'Bearer ' + token, 'Accept': 'application/json' },
          credentials: 'same-origin'
        }).then(function(res) {
          if (res.status === 404) return null;
          if (!res.ok) return null;
          return res.json();
        }).then(function(data) {
          if (!data || data.chapterNumber == null) return;
          var localMeta = null;
          try { localMeta = JSON.parse(localStorage.getItem(progressMetaKey) || 'null'); } catch (e) { localMeta = null; }
          var localTs = localMeta && localMeta.updatedAt ? Date.parse(localMeta.updatedAt) : 0;
          var cloudTs = data.updatedAt ? Date.parse(data.updatedAt) : 0;
          if (!cloudTs) return;
          if (localTs && localTs >= cloudTs) return;
          // 云端更新：若同一章则滚动；若不同章仅更新 meta（不强制跳章，避免打断当前阅读）
          try {
            localStorage.setItem(progressMetaKey, JSON.stringify({
              chapterNumber: data.chapterNumber,
              offsetRatio: data.offsetRatio,
              updatedAt: data.updatedAt
            }));
          } catch (e) { /* ignore */ }
          if (Number(data.chapterNumber) === chapterNumber) {
            applyOffsetRatio(data.offsetRatio);
            localStorage.setItem(progressKey, String(data.offsetRatio || 0));
          }
        }).catch(function() { /* ignore */ });
      })();

      var saveTimer = null;
      window.addEventListener('scroll', function() {
        if (saveTimer) clearTimeout(saveTimer);
        saveTimer = setTimeout(function() {
          var ratio = currentOffsetRatio();
          saveLocalProgress(ratio);
          syncProgressToCloud(ratio);
        }, 400);
      }, { passive: true });

      document.addEventListener('keydown', function(e) {
        var tag = e.target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
        if (e.key === 'ArrowLeft') {
          var prev = document.querySelector('a[rel="prev"]');
          if (prev) window.location.href = prev.href;
        } else if (e.key === 'ArrowRight') {
          var next = document.querySelector('a[rel="next"]');
          if (next) window.location.href = next.href;
        }
      });

      // 书架：触控按下即跳转，减少大页面上的 click 延迟
      var shelf = document.getElementById('header-shelf');
      if (shelf) {
        shelf.addEventListener('pointerdown', function(e) {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
          var href = shelf.href;
          if (!href) return;
          e.preventDefault();
          window.location.assign(href);
        }, { passive: false });
      }
    })();
  </script>
</body>
</html>
