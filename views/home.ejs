<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>书库</title>
  <meta name="description" content="在线小说书库">
  <link rel="canonical" href="<%= baseUrl %>/">
  <meta property="og:title" content="书库">
  <meta property="og:description" content="在线小说书库">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= baseUrl %>/">
  <link rel="stylesheet" href="/css/main.css?v=20260807f">
</head>
<body>
  <header id="site-header">
    <div class="header-inner">
      <span class="site-name">书库</span>
      <nav class="header-auth" id="header-auth" aria-label="账号">
        <a href="/login">登录</a>
      </nav>
    </div>
  </header>
  <script>
    (function () {
      var el = document.getElementById('header-auth');
      if (!el) return;
      var token = '';
      try { token = localStorage.getItem('codexnovel_access_token') || ''; } catch (e) {}
      if (token) {
        el.innerHTML = '<a href="/logout">退出</a>';
      } else {
        el.innerHTML = '<a href="/login">登录</a>';
      }
    })();
  </script>

  <main>
    <section class="library-page">
      <header class="novel-meta">
        <h1>书库</h1>
      </header>

      <nav class="library-list" aria-label="小说列表">
        <% novels.forEach(function(novel) { %>
          <a class="library-item" href="/novel/<%= novel.id %>">
            <span class="library-item-main">
              <% if (novel.cover_image) { %>
                <img class="library-cover" src="<%= novel.cover_image %>" alt="<%= novel.title %> 封面" loading="lazy">
              <% } else { %>
                <span class="library-cover library-cover-placeholder" aria-hidden="true"></span>
              <% } %>
              <span class="library-item-text">
                <strong><%= novel.title %></strong>
                <% if (novel.description) { %>
                  <small><%= novel.description %></small>
                <% } %>
              </span>
            </span>
            <em><%= novel.chapter_count %> 章</em>
          </a>
        <% }) %>
        <% if (novels.length === 0) { %>
          <p class="empty">暂无小说</p>
        <% } %>
      </nav>
    </section>
  </main>

  <footer id="site-footer">
    <p></p>
  </footer>
</body>
</html>
