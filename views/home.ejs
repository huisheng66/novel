<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>书库</title>
  <meta name="description" content="浏览书库，选择小说开始阅读">
  <link rel="canonical" href="<%= baseUrl %>/">
  <meta property="og:title" content="书库">
  <meta property="og:description" content="浏览书库，选择小说开始阅读">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= baseUrl %>/">
  <link rel="stylesheet" href="/css/main.css?v=20261031a">
  <link rel="stylesheet" href="/css/feedback-modal.css?v=20261102d">
  <script src="/js/site.js?v=20261031a" defer></script>
</head>
<body>
  <%- include('partials/site-header', { currentPage: 'library' }) %>

  <main id="main-content">
    <section class="library-page" aria-labelledby="library-title">
      <header class="page-heading">
        <p class="page-eyebrow">全部小说</p>
        <h1 id="library-title">找一本好书，开始阅读</h1>
        <p class="page-description">搜索书名或简介，进入书籍详情后即可查看目录并开始阅读。</p>
      </header>

      <div class="library-toolbar">
        <form class="search-box" id="library-search" role="search" autocomplete="off">
          <label for="library-search-input">搜索书库</label>
          <div class="search-input-row">
            <input type="search" id="library-search-input" placeholder="输入书名或简介" inputmode="search">
            <button class="button button-secondary" id="library-search-clear" type="button">清除</button>
          </div>
        </form>
        <p class="result-count" id="library-result-count" role="status">共 <%= novels.length %> 本小说</p>
      </div>

      <div class="library-list" id="library-list">
        <% novels.forEach(function(novel) { %>
          <a class="library-item library-item-main" href="/novel/<%= novel.id %>" data-search="<%= novel.title + ' ' + (novel.description || '') %>">
            <% if (novel.cover_image) { %>
              <img class="library-cover" src="<%= novel.cover_image %>" alt="<%= novel.title %> 封面" loading="lazy">
            <% } else { %>
              <span class="library-cover library-cover-placeholder" aria-hidden="true"></span>
            <% } %>
            <span class="library-item-text">
              <strong><%= novel.title %></strong>
              <% if (novel.description) { %>
                <small><%= novel.description %></small>
              <% } %>
              <span class="library-item-meta"><%= novel.chapter_count %> 章 <span aria-hidden="true">·</span> 查看详情与目录 <span aria-hidden="true">→</span></span>
            </span>
          </a>
        <% }) %>
      </div>

      <div class="empty-state" id="library-empty"<%= novels.length ? ' hidden' : '' %>>
        <h2><%= novels.length ? '没有找到匹配的小说' : '书库还是空的' %></h2>
        <p><%= novels.length ? '换一个书名或关键词试试。' : '暂时没有可阅读的小说，请稍后再来。' %></p>
      </div>
    </section>
  </main>

  <footer id="site-footer"><p>选择一本书，安静读下去。</p></footer>

  <!-- 浮动搜索框 -->
  <div class="library-search-island" id="library-search-island">
    <form class="chapter-search-form" role="search" autocomplete="off">
      <label for="floating-library-search" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">搜索书库</label>
      <input type="search" id="floating-library-search" class="chapter-search-input" placeholder="搜索书库" inputmode="search">
      <button type="button" class="chapter-search-clear" id="floating-library-clear" aria-label="清除搜索">×</button>
    </form>
  </div>

  <!-- 返回顶部按钮 -->
  <button class="back-to-top" id="back-to-top" type="button" aria-label="返回顶部" hidden>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 5l-7 7h4v7h6v-7h4z" fill="currentColor"/></svg>
  </button>

  <!-- 反馈模态框 -->
  <div class="feedback-overlay" id="feedback-overlay"></div>
  <div class="feedback-modal" id="feedback-modal">
    <div class="feedback-header">
      <h2 class="feedback-title">用户反馈</h2>
      <button class="feedback-close" id="feedback-close" type="button" aria-label="关闭">×</button>
    </div>
    <div class="feedback-status" id="feedback-status"></div>
    <form class="feedback-form" id="feedback-form">
      <div class="feedback-field">
        <label class="feedback-label" for="feedback-email">
          邮箱 <span class="optional">(选填，用于接收回复)</span>
        </label>
        <input
          type="email"
          class="feedback-input"
          id="feedback-email"
          placeholder="your@email.com"
          autocomplete="email"
        >
      </div>
      <div class="feedback-field">
        <label class="feedback-label" for="feedback-content">
          反馈内容 <span style="color: #d32f2f;">*</span>
        </label>
        <textarea
          class="feedback-textarea"
          id="feedback-content"
          placeholder="请描述您遇到的问题或建议..."
          required
        ></textarea>
      </div>
      <div class="feedback-actions">
        <button type="button" class="feedback-btn feedback-btn-cancel" id="feedback-cancel">取消</button>
        <button type="submit" class="feedback-btn feedback-btn-submit" id="feedback-submit">提交</button>
      </div>
    </form>
  </div>

  <script>
    (function () {
      var input = document.getElementById('library-search-input');
      var clear = document.getElementById('library-search-clear');
      var items = Array.prototype.slice.call(document.querySelectorAll('.library-item[data-search]'));
      var count = document.getElementById('library-result-count');
      var empty = document.getElementById('library-empty');
      if (!input) return;

      function filterLibrary() {
        var query = input.value.trim().toLowerCase();
        var matched = 0;
        items.forEach(function (item) {
          var hit = !query || (item.getAttribute('data-search') || '').toLowerCase().indexOf(query) !== -1;
          item.hidden = !hit;
          if (hit) matched += 1;
        });
        count.textContent = query ? '找到 ' + matched + ' 本小说' : '共 ' + items.length + ' 本小说';
        empty.hidden = matched !== 0;
        if (query && matched === 0) {
          empty.querySelector('h2').textContent = '没有找到匹配的小说';
          empty.querySelector('p').textContent = '换一个书名或关键词试试。';
        }
      }

      input.addEventListener('input', filterLibrary);
      clear.addEventListener('click', function () {
        input.value = '';
        filterLibrary();
        input.focus();
      });
      document.getElementById('library-search').addEventListener('submit', function (event) {
        event.preventDefault();
        filterLibrary();
      });

      // 浮动搜索框同步
      var floatingInput = document.getElementById('floating-library-search');
      var floatingClear = document.getElementById('floating-library-clear');
      var floatingIsland = document.getElementById('library-search-island');

      if (floatingInput) {
        floatingInput.addEventListener('input', function () {
          input.value = floatingInput.value;
          filterLibrary();
        });
        floatingClear.addEventListener('click', function () {
          input.value = '';
          floatingInput.value = '';
          filterLibrary();
          floatingInput.focus();
        });
        // 同步主搜索框到浮动搜索框
        input.addEventListener('input', function () {
          floatingInput.value = input.value;
        });
      }

      // 浮动搜索框显示/隐藏
      var searchShown = false;
      var scrollRaf = 0;
      var hasContent = false;

      function updateFloatingSearch() {
        scrollRaf = 0;
        // 如果有输入内容，始终显示；否则根据滚动位置
        var shouldShow = hasContent || window.scrollY > 300;
        if (shouldShow === searchShown) return;
        searchShown = shouldShow;
        floatingIsland.classList.toggle('is-visible', shouldShow);
      }

      // 监听输入内容变化
      if (floatingInput) {
        var originalInputListener = floatingInput.oninput;
        floatingInput.addEventListener('input', function () {
          hasContent = floatingInput.value.trim().length > 0;
          updateFloatingSearch();
        });
      }

      window.addEventListener('scroll', function () {
        if (!scrollRaf) scrollRaf = requestAnimationFrame(updateFloatingSearch);
      }, { passive: true });

      // 返回顶部按钮
      var backBtn = document.getElementById('back-to-top');
      var backShown = false;
      var backRaf = 0;
      function updateBackButton() {
        backRaf = 0;
        var shouldShow = window.scrollY > 500;
        if (shouldShow === backShown) return;
        backShown = shouldShow;
        backBtn.hidden = !shouldShow;
        backBtn.classList.toggle('is-visible', shouldShow);
      }
      window.addEventListener('scroll', function () {
        if (!backRaf) backRaf = requestAnimationFrame(updateBackButton);
      }, { passive: true });
      backBtn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    })();

    // 反馈模态框
    (function () {
      var feedbackTrigger = document.getElementById('feedback-trigger');
      var feedbackModal = document.getElementById('feedback-modal');
      var feedbackOverlay = document.getElementById('feedback-overlay');
      var feedbackClose = document.getElementById('feedback-close');
      var feedbackCancel = document.getElementById('feedback-cancel');
      var feedbackForm = document.getElementById('feedback-form');
      var feedbackStatus = document.getElementById('feedback-status');

      function openFeedback() {
        feedbackOverlay.classList.add('active');
        feedbackModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeFeedback() {
        feedbackOverlay.classList.remove('active');
        feedbackModal.classList.remove('active');
        document.body.style.overflow = '';
        feedbackStatus.className = 'feedback-status';
        feedbackStatus.textContent = '';
      }

      if (feedbackTrigger) {
        feedbackTrigger.addEventListener('click', openFeedback);
      }
      if (feedbackClose) feedbackClose.addEventListener('click', closeFeedback);
      if (feedbackCancel) feedbackCancel.addEventListener('click', closeFeedback);
      if (feedbackOverlay) feedbackOverlay.addEventListener('click', closeFeedback);

      if (feedbackForm) {
        feedbackForm.addEventListener('submit', function (e) {
          e.preventDefault();

          var email = document.getElementById('feedback-email').value.trim();
          var content = document.getElementById('feedback-content').value.trim();
          var submitBtn = document.getElementById('feedback-submit');

          if (!content) {
            feedbackStatus.className = 'feedback-status error';
            feedbackStatus.textContent = '请填写反馈内容';
            return;
          }

          submitBtn.disabled = true;
          submitBtn.textContent = '提交中...';
          feedbackStatus.className = 'feedback-status';
          feedbackStatus.textContent = '';

          fetch('/api/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, content: content })
          })
          .then(function (res) {
            if (!res.ok) throw new Error('提交失败');
            return res.json();
          })
          .then(function () {
            feedbackStatus.className = 'feedback-status success';
            feedbackStatus.textContent = '提交成功，感谢您的反馈！';
            feedbackForm.reset();
            setTimeout(closeFeedback, 2000);
          })
          .catch(function (err) {
            feedbackStatus.className = 'feedback-status error';
            feedbackStatus.textContent = err.message || '提交失败，请稍后重试';
          })
          .finally(function () {
            submitBtn.disabled = false;
            submitBtn.textContent = '提交';
          });
        });
      }
    })();
  </script>

</body>
</html>
