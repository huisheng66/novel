<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>设置新密码｜书库</title>
  <link rel="stylesheet" href="/css/main.css?v=20261031a">
  <script src="/js/site.js?v=20261031a" defer></script>
</head>
<body class="auth-body">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <header class="auth-header"><a class="site-name" href="/">书库</a><a href="/">返回书库</a></header>
  <main class="auth-page" id="main-content">
    <p class="page-eyebrow">账号安全</p>
    <h1>设置新密码</h1>
    <p class="hint">两次输入需保持一致。重置后所有设备都会退出，需要使用新密码重新登录。</p>
    <% if (error) { %><div class="auth-alert auth-alert-error" role="alert"><%= error %></div><% } %>
    <div class="auth-alert auth-alert-error" id="password-match-error" role="alert" hidden>两次输入的密码不一致，请重新确认。</div>
    <form method="post" action="/reset-password" autocomplete="on" data-loading="正在重置…" id="reset-form">
      <input type="hidden" name="token" value="<%= token %>">
      <label for="reset-password">新密码 <span class="required-mark">至少 8 位</span></label>
      <input id="reset-password" type="password" name="password" required minlength="8" placeholder="输入新密码" autocomplete="new-password" autofocus>
      <label for="reset-password-confirm">确认新密码</label>
      <input id="reset-password-confirm" type="password" name="password2" required minlength="8" placeholder="再次输入新密码" autocomplete="new-password">
      <button class="button button-primary" type="submit">保存新密码</button>
    </form>
    <div class="auth-links"><a href="/login">返回登录</a></div>
  </main>
  <script>
    (function () {
      var form = document.getElementById('reset-form');
      var error = document.getElementById('password-match-error');
      var password = document.getElementById('reset-password');
      var confirm = document.getElementById('reset-password-confirm');
      form.addEventListener('submit', function (event) {
        var matched = password.value === confirm.value;
        error.hidden = matched;
        confirm.setAttribute('aria-invalid', String(!matched));
        if (!matched) { event.preventDefault(); event.stopImmediatePropagation(); confirm.focus(); }
      }, true);
      confirm.addEventListener('input', function () { error.hidden = true; confirm.removeAttribute('aria-invalid'); });
    })();
  </script>
</body>
</html>
