<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title><%= title %>｜书库</title>
  <link rel="stylesheet" href="/css/main.css?v=20261031a">
</head>
<body class="auth-body">
  <header class="auth-header"><a class="site-name" href="/">书库</a><a href="/">返回书库</a></header>
  <main class="auth-page auth-result" id="main-content">
    <div class="auth-icon <%= ok ? 'ok' : 'fail' %>" aria-hidden="true"><%= ok ? '✓' : '!' %></div>
    <p class="page-eyebrow"><%= ok ? '操作已完成' : '操作未完成' %></p>
    <h1><%= title %></h1>
    <p><%= message %></p>
    <a class="button button-primary" href="<%= linkHref %>"><%= linkText %></a>
  </main>
</body>
</html>
