<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= novel.title %>｜书库</title>
  <meta name="description" content="<%= novel.description || novel.title %>">
  <link rel="canonical" href="<%= baseUrl %>/novel/<%= novel.id %>">
  <meta property="og:title" content="<%= novel.title %>">
  <meta property="og:description" content="<%= novel.description || novel.title %>">
  <meta property="og:type" content="book">
  <meta property="og:url" content="<%= baseUrl %>/novel/<%= novel.id %>">
  <% if (novel.cover_image) { %>
    <meta property="og:image" content="<%= novel.cover_image.startsWith('http') ? novel.cover_image : baseUrl + novel.cover_image %>">
  <% } %>
  <link rel="stylesheet" href="/css/main.css?v=20261031a">
  <script src="/js/site.js?v=20261031a" defer></script>
</head>
<body>
  <%- include('partials/site-header', { currentPage: 'library', breadcrumb: novel.title }) %>

  <main id="main-content">
    <article class="novel-detail">
      <header class="novel-meta novel-meta-with-cover">
        <% if (novel.cover_image) { %>
          <img class="novel-cover" src="<%= novel.cover_image %>" alt="<%= novel.title %> 封面" fetchpriority="high">
        <% } else { %>
          <span class="novel-cover novel-cover-placeholder" aria-hidden="true"></span>
        <% } %>
        <div class="novel-summary">
          <p class="page-eyebrow">书籍详情</p>
          <h1><%= novel.title %></h1>
          <p class="novel-desc"><%= novel.description || '暂无简介' %></p>
          <p class="novel-chapter-total">共 <%= chapters.length %> 章</p>
          <% if (chapters.length) { %>
            <div class="novel-actions">
              <a class="button button-primary" id="start-reading" href="/novel/<%= novel.id %>/<%= chapters[0].chapter_number %>">开始阅读</a>
              <a class="button button-secondary" href="#chapter-list">浏览目录</a>
            </div>
            <p class="continue-hint" id="continue-hint" hidden></p>
          <% } %>
        </div>
      </header>

      <section class="chapter-list" aria-labelledby="chapter-list-title" id="chapter-list">
        <div class="section-heading">
          <div>
            <p class="page-eyebrow">按顺序阅读</p>
            <h2 id="chapter-list-title">章节目录</h2>
          </div>
          <span class="section-meta">共 <%= chapters.length %> 章</span>
        </div>

        <% if (typeof paywall !== 'undefined' && paywall && paywall.unlockFullPrice && paywall.unlockFullPrice > 0) { %>
          <div class="unlock-full-banner" style="background:var(--surface-2,#0F131C);padding:1rem 1.25rem;border-radius:12px;margin-bottom:1.5rem;border:1px solid var(--border,rgba(255,255,255,0.08));display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center">
            <div>
              <h3 style="margin:0 0 0.25rem;font-size:1rem;color:var(--text,#fff);font-weight:600">按本解锁整本书</h3>
              <p style="margin:0;color:var(--muted,rgba(255,255,255,0.7));font-size:0.9rem">一次性解锁所有付费章节 · ¥<%= (paywall.unlockFullPrice / 100).toFixed(2) %></p>
            </div>
            <form action="/novel/<%= novel.id %>/buy-full" method="post" data-loading="正在解锁…" style="margin:0">
              <button class="button button-primary" type="submit" style="white-space:nowrap">立即解锁</button>
            </form>
          </div>
        <% } %>

        <ol id="chapter-list-ol" class="chapter-list-ol">
          <% chapters.forEach(function(ch) {
            var n = ch.chapter_number;
            var numStr = n < 10 ? ('0' + n) : String(n);
            var isPaid = false;
            if (typeof paywall !== 'undefined' && paywall && paywall.enabled) {
              var ov = paywall.overrides && paywall.overrides.get ? paywall.overrides.get(n) : null;
              if (ov && (ov.isFree === 0 || ov.isFree === false)) isPaid = true;
              else if (ov && (ov.isFree === 1 || ov.isFree === true)) isPaid = false;
              else isPaid = n > paywall.freeUntil;
            }
          %>
            <li data-n="<%= n %>"<%= isPaid ? ' class="is-paid"' : '' %>>
              <a href="/novel/<%= novel.id %>/<%= n %>"><span class="ch-num"><%= numStr %></span><span class="chapter-title"><%= ch.title %></span><% if (isPaid) { %><span class="chapter-lock">付费</span><% } %></a>
            </li>
          <% }) %>
        </ol>
        <% if (chapters.length === 0) { %>
          <div class="empty-state"><h2>暂无章节</h2><p>这本书还没有可阅读的内容。</p></div>
        <% } %>
        <p class="chapter-search-empty" id="chapter-search-empty" role="status" hidden>没有匹配的章节，请换个关键词。</p>
      </section>
    </article>
  </main>

  <footer id="site-footer"><p><a href="/">返回书库，选择其他小说</a></p></footer>

  <!-- 浮动搜索框 -->
  <div class="chapter-search-island" id="chapter-search-island">
    <form class="chapter-search-form" role="search" autocomplete="off">
      <label for="floating-chapter-search" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">搜索章节</label>
      <input type="search" id="floating-chapter-search" class="chapter-search-input" placeholder="搜索章节" inputmode="search">
      <button type="button" class="chapter-search-clear" id="floating-chapter-clear" aria-label="清除搜索">×</button>
      <span class="chapter-search-count" id="floating-chapter-count" role="status" aria-live="polite"></span>
    </form>
  </div>

  <!-- 返回顶部按钮 -->
  <button class="back-to-top" id="back-to-top" type="button" aria-label="返回顶部" hidden>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 5l-7 7h4v7h6v-7h4z" fill="currentColor"/></svg>
  </button>

  <script>
    (function () {
      var ol = document.getElementById('chapter-list-ol');
      var backBtn = document.getElementById('back-to-top');
      var novelId = '<%= novel.id %>';

      var start = document.getElementById('start-reading');
      if (start) {
        try {
          var meta = JSON.parse(localStorage.getItem('reading-progress-meta:' + novelId) || 'null');
          if (meta && meta.chapterNumber) {
            var savedLink = ol.querySelector('li[data-n="' + Number(meta.chapterNumber) + '"] a');
            if (savedLink) {
              start.href = savedLink.href;
              start.textContent = '继续阅读 · 第 ' + Number(meta.chapterNumber) + ' 章';
              var hint = document.getElementById('continue-hint');
              hint.textContent = '已找到你在这台设备上的最近阅读位置。';
              hint.hidden = false;
            }
          }
        } catch (e) {}
      }

      if (ol) {
        var items = ol.querySelectorAll('li[data-n]');
        var filterTimer = 0;
        var filterToken = 0;
        var CHUNK = 120;

        // 浮动搜索框元素
        var floatingInput = document.getElementById('floating-chapter-search');
        var floatingClear = document.getElementById('floating-chapter-clear');
        var floatingCount = document.getElementById('floating-chapter-count');
        var floatingIsland = document.getElementById('chapter-search-island');
        var emptyEl = document.getElementById('chapter-search-empty');

        function applyFilter(value) {
          var query = String(value || '').trim().toLowerCase();
          var total = items.length;
          var matched = 0;
          var index = 0;
          var token = ++filterToken;

          function updateChunk() {
            if (token !== filterToken) return;
            var end = Math.min(index + CHUNK, total);
            for (; index < end; index += 1) {
              var item = items[index];
              var hit = !query || (item.getAttribute('data-n') || '').indexOf(query) !== -1 || (item.textContent || '').toLowerCase().indexOf(query) !== -1;
              item.classList.toggle('chapter-filtered-out', !hit);
              if (hit) matched += 1;
            }
            if (index < total) {
              if ('requestIdleCallback' in window) {
                requestIdleCallback(updateChunk);
              } else {
                requestAnimationFrame(updateChunk);
              }
            } else {
              floatingCount.textContent = query ? '找到 ' + matched + ' / ' + total + ' 章' : '';
              if (emptyEl) emptyEl.hidden = matched !== 0;
            }
          }
          updateChunk();
        }

        if (floatingInput) {
          floatingInput.addEventListener('input', function () {
            clearTimeout(filterTimer);
            filterTimer = setTimeout(function () { applyFilter(floatingInput.value); }, 100);
          });
          floatingClear.addEventListener('click', function () {
            floatingInput.value = '';
            applyFilter('');
            floatingInput.focus();
          });
        }

        // 浮动搜索框显示/隐藏
        var searchShown = false;
        var searchRaf = 0;
        function updateFloatingSearch() {
          searchRaf = 0;
          var shouldShow = window.scrollY > 300;
          if (shouldShow === searchShown) return;
          searchShown = shouldShow;
          floatingIsland.classList.toggle('is-visible', shouldShow);
        }
        window.addEventListener('scroll', function () {
          if (!searchRaf) searchRaf = requestAnimationFrame(updateFloatingSearch);
        }, { passive: true });
      }

      var backShown = false;
      var scrollRaf = 0;
      function updateBackButton() {
        scrollRaf = 0;
        var shouldShow = window.scrollY > 500;
        if (shouldShow === backShown) return;
        backShown = shouldShow;
        backBtn.hidden = !shouldShow;
        backBtn.classList.toggle('is-visible', shouldShow);
      }
      window.addEventListener('scroll', function () {
        if (!scrollRaf) scrollRaf = requestAnimationFrame(updateBackButton);
      }, { passive: true });
      backBtn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    })();
  </script>
</body>
</html>
