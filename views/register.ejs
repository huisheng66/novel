<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>注册｜书库</title>
  <link rel="stylesheet" href="/css/main.css?v=20261031a">
  <script src="/js/site.js?v=20261031a" defer></script>
</head>
<body class="auth-body">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <header class="auth-header"><a class="site-name" href="/">书库</a><a href="/">返回书库</a></header>
  <main class="auth-page" id="main-content">
    <p class="page-eyebrow">创建账号</p>
    <h1>注册</h1>
    <p class="hint">使用邮箱注册，注册成功后会自动登录。显示名和邀请码都可以留空。</p>
    <% if (error) { %><div class="auth-alert auth-alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/register" autocomplete="on" data-loading="正在注册…">
      <input type="hidden" name="next" value="<%= nextPath || '/' %>">
      <label for="register-email">邮箱 <span class="required-mark">必填</span></label>
      <input id="register-email" type="email" name="email" required maxlength="255" placeholder="you@example.com" autocomplete="email" autofocus>
      <label for="register-password">密码 <span class="required-mark">至少 8 位</span></label>
      <input id="register-password" type="password" name="password" required minlength="8" placeholder="设置登录密码" autocomplete="new-password">
      <label for="register-name">显示名 <span class="optional-mark">选填</span></label>
      <input id="register-name" type="text" name="displayName" maxlength="100" placeholder="留空则使用邮箱前缀" autocomplete="nickname">
      <label for="register-invite">邀请码 <span class="optional-mark">选填</span></label>
      <input id="register-invite" class="uppercase-input" type="text" name="inviteCode" maxlength="32" placeholder="有邀请码时填写" autocomplete="off">
      <button class="button button-primary" type="submit">注册并登录</button>
    </form>
    <div class="auth-links"><a href="/login?next=<%= encodeURIComponent(nextPath || '/') %>">已有账号？去登录</a></div>
  </main>
</body>
</html>
