<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登录｜书库</title>
  <link rel="stylesheet" href="/css/main.css?v=20261031a">
  <script src="/js/site.js?v=20261031a" defer></script>
</head>
<body class="auth-body">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <header class="auth-header"><a class="site-name" href="/">书库</a><a href="/">返回书库</a></header>
  <main class="auth-page" id="main-content">
    <p class="page-eyebrow">欢迎回来</p>
    <h1>登录账号</h1>
    <p class="hint">使用邮箱或用户名登录。登录后可同步阅读进度、充值并解锁付费章节。</p>
    <% if (error) { %><div class="auth-alert auth-alert-error" role="alert"><%= error %></div><% } %>
    <% if (notice) { %><div class="auth-alert auth-alert-ok" role="status"><%= notice %></div><% } %>
    <form method="post" action="/login" autocomplete="on" data-loading="正在登录…">
      <input type="hidden" name="next" value="<%= nextPath || '/' %>">
      <label for="login-name">邮箱或用户名</label>
      <input id="login-name" type="text" name="email" required maxlength="255" placeholder="you@example.com 或用户名" autocomplete="username" autofocus>
      <label for="login-password">密码</label>
      <input id="login-password" type="password" name="password" required minlength="8" placeholder="输入密码" autocomplete="current-password">
      <button class="button button-primary" type="submit">登录</button>
    </form>
    <div class="auth-links">
      <a href="/forgot-password">忘记密码？</a>
      <% if (registerEnabled) { %><a href="/register?next=<%= encodeURIComponent(nextPath || '/') %>">没有账号？注册</a><% } else { %><span>注册已关闭，请联系管理员</span><% } %>
    </div>
    <p class="auth-footnote">网页与 ReadAny App 使用同一账号。</p>
  </main>
</body>
</html>
