<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>我的｜书库</title>
  <link rel="stylesheet" href="/css/main.css?v=20261031a">
  <link rel="stylesheet" href="/css/feedback-modal.css?v=20261102d">
  <script src="/js/site.js?v=20261031a" defer></script>
</head>
<body>
  <%- include('partials/site-header', { currentPage: 'account', breadcrumb: '我的', serverLoggedIn: true }) %>

  <main class="wallet-main" id="main-content">
    <header class="page-heading wallet-heading">
      <p class="page-eyebrow">账号与阅读服务</p>
      <h1>我的</h1>
      <p class="page-description"><%= webUser.displayName || webUser.username %>，在这里管理余额、充值和已购内容。</p>
    </header>

    <nav class="wallet-shortcuts" aria-label="本页内容">
      <a href="#redeem">兑换码充值</a>
      <a href="#transactions">消费记录</a>
      <a href="#purchases">已购章节</a>
    </nav>

    <% if (notice) { %><div class="wallet-alert wallet-alert-ok" role="status"><%= notice %></div><% } %>
    <% if (error) { %><div class="wallet-alert wallet-alert-error" role="alert"><%= error %></div><% } %>

    <section class="wallet-card wallet-balance-card" aria-labelledby="balance-title">
      <div>
        <p class="wallet-label" id="balance-title">当前可用余额</p>
        <p class="wallet-balance">¥<%= yuan(wallet.balance) %></p>
        <p class="wallet-user">余额可用于解锁付费章节</p>
      </div>
      <a class="button button-secondary" href="#redeem">去充值</a>
    </section>

    <% if (webUser.email && !webUser.emailVerified) { %>
      <section class="wallet-card" aria-labelledby="email-status-title">
        <h2 class="wallet-h2" id="email-status-title">邮箱尚未验证</h2>
        <p class="wallet-hint wallet-section-text"><%= webUser.email %> 还没有验证。验证后可用于找回密码；如果站点要求验证后登录或购买，请先完成验证。</p>
        <form class="wallet-form" action="/verify-email/resend" method="post" data-loading="正在发送…">
          <button class="button button-secondary" type="submit">重新发送验证邮件</button>
        </form>
      </section>
    <% } %>

    <section class="wallet-card" id="redeem" aria-labelledby="redeem-title">
      <h2 class="wallet-h2" id="redeem-title">兑换码充值</h2>
      <p class="wallet-hint wallet-section-text">输入站长发放的兑换码，成功后金额会立即计入余额。</p>
      <form class="wallet-form" action="/wallet/redeem" method="post" data-loading="正在充值…">
        <label class="sr-only" for="redeem-code">兑换码</label>
        <input id="redeem-code" type="text" name="code" placeholder="输入或粘贴兑换码" autocomplete="off" required maxlength="64">
        <button class="button button-primary" type="submit">确认充值</button>
      </form>
      <p class="wallet-hint">每个兑换码只能使用一次，请核对后再提交。</p>
    </section>

    <section class="wallet-card" id="transactions" aria-labelledby="transactions-title">
      <div class="section-heading compact-heading">
        <h2 class="wallet-h2" id="transactions-title">消费记录</h2>
        <span class="section-meta">最近 <%= transactions.length %> 条</span>
      </div>
      <% if (transactions.length === 0) { %>
        <div class="empty-state compact-empty"><p>还没有余额变动记录。</p></div>
      <% } else { %>
        <div class="wallet-table-wrap" tabindex="0" role="region" aria-label="消费记录，可横向滚动">
          <table class="wallet-table">
            <caption class="sr-only">最近余额变动记录</caption>
            <thead><tr><th scope="col">时间</th><th scope="col">类型</th><th scope="col">金额</th><th scope="col">余额</th><th scope="col">备注</th></tr></thead>
            <tbody>
              <% transactions.forEach(function(tx) { %>
                <tr>
                  <td><%= new Date(tx.createdAt).toLocaleString('zh-CN') %></td>
                  <td><%= tx.type === 'recharge' ? '充值' : (tx.type === 'purchase' ? '购买' : '调整') %></td>
                  <td class="<%= tx.delta < 0 ? 'wallet-out' : 'wallet-in' %>"><%= tx.delta < 0 ? '-' : '+' %>¥<%= yuan(Math.abs(tx.delta)) %></td>
                  <td>¥<%= yuan(tx.balanceAfter) %></td>
                  <td><%= tx.note || tx.ref || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="wallet-card" id="purchases" aria-labelledby="purchases-title">
      <div class="section-heading compact-heading">
        <h2 class="wallet-h2" id="purchases-title">已购章节</h2>
        <span class="section-meta">最近 <%= purchases.length %> 条</span>
      </div>
      <% if (purchases.length === 0) { %>
        <div class="empty-state compact-empty"><p>还没有购买过章节，可从书籍目录选择内容。</p><a href="/">返回书库</a></div>
      <% } else { %>
        <ul class="wallet-purchase-list">
          <% purchases.forEach(function(item) { %>
            <li><a href="/novel/<%= item.novelId %>/<%= item.chapterNumber %>">书 <%= item.novelId %> · 第 <%= item.chapterNumber %> 章</a><span>¥<%= yuan(item.amount) %></span></li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </main>
  <footer id="site-footer"><p><a href="/">返回书库继续阅读</a></p></footer>

  <!-- 反馈模态框 -->
  <div class="feedback-overlay" id="feedback-overlay"></div>
  <div class="feedback-modal" id="feedback-modal">
    <div class="feedback-header">
      <h2 class="feedback-title">用户反馈</h2>
      <button class="feedback-close" id="feedback-close" type="button" aria-label="关闭">×</button>
    </div>
    <div class="feedback-status" id="feedback-status"></div>
    <form class="feedback-form" id="feedback-form">
      <div class="feedback-field">
        <label class="feedback-label" for="feedback-email">
          邮箱 <span class="optional">(选填，用于接收回复)</span>
        </label>
        <input
          type="email"
          class="feedback-input"
          id="feedback-email"
          placeholder="your@email.com"
          autocomplete="email"
        >
      </div>
      <div class="feedback-field">
        <label class="feedback-label" for="feedback-content">
          反馈内容 <span style="color: #d32f2f;">*</span>
        </label>
        <textarea
          class="feedback-textarea"
          id="feedback-content"
          placeholder="请描述您遇到的问题或建议..."
          required
        ></textarea>
      </div>
      <div class="feedback-actions">
        <button type="button" class="feedback-btn feedback-btn-cancel" id="feedback-cancel">取消</button>
        <button type="submit" class="feedback-btn feedback-btn-submit" id="feedback-submit">提交</button>
      </div>
    </form>
  </div>

  <script>
    (function () {
      var feedbackTrigger = document.getElementById('feedback-trigger');
      var feedbackModal = document.getElementById('feedback-modal');
      var feedbackOverlay = document.getElementById('feedback-overlay');
      var feedbackClose = document.getElementById('feedback-close');
      var feedbackCancel = document.getElementById('feedback-cancel');
      var feedbackForm = document.getElementById('feedback-form');
      var feedbackStatus = document.getElementById('feedback-status');

      function openFeedback() {
        feedbackOverlay.classList.add('active');
        feedbackModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeFeedback() {
        feedbackOverlay.classList.remove('active');
        feedbackModal.classList.remove('active');
        document.body.style.overflow = '';
        feedbackStatus.className = 'feedback-status';
        feedbackStatus.textContent = '';
      }

      if (feedbackTrigger) {
        feedbackTrigger.addEventListener('click', openFeedback);
      }
      if (feedbackClose) feedbackClose.addEventListener('click', closeFeedback);
      if (feedbackCancel) feedbackCancel.addEventListener('click', closeFeedback);
      if (feedbackOverlay) feedbackOverlay.addEventListener('click', closeFeedback);

      if (feedbackForm) {
        feedbackForm.addEventListener('submit', function (e) {
          e.preventDefault();

          var email = document.getElementById('feedback-email').value.trim();
          var content = document.getElementById('feedback-content').value.trim();
          var submitBtn = document.getElementById('feedback-submit');

          if (!content) {
            feedbackStatus.className = 'feedback-status error';
            feedbackStatus.textContent = '请填写反馈内容';
            return;
          }

          submitBtn.disabled = true;
          submitBtn.textContent = '提交中...';
          feedbackStatus.className = 'feedback-status';
          feedbackStatus.textContent = '';

          fetch('/api/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, content: content })
          })
          .then(function (res) {
            if (!res.ok) throw new Error('提交失败');
            return res.json();
          })
          .then(function () {
            feedbackStatus.className = 'feedback-status success';
            feedbackStatus.textContent = '提交成功，感谢您的反馈！';
            feedbackForm.reset();
            setTimeout(closeFeedback, 2000);
          })
          .catch(function (err) {
            feedbackStatus.className = 'feedback-status error';
            feedbackStatus.textContent = err.message || '提交失败，请稍后重试';
          })
          .finally(function () {
            submitBtn.disabled = false;
            submitBtn.textContent = '提交';
          });
        });
      }
    })();
  </script>
</body>
</html>
