<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>仪表盘 - 后台管理</title>
  <link rel="stylesheet" href="/css/main.css?v=20261101a">
  <link rel="stylesheet" href="/css/admin.css?v=20261101a">
</head>
<body class="admin-body">
  <%- include('../partials/admin-header', { activePage: 'dashboard' }) %>

  <main class="admin-main admin-dashboard-main">
    <section class="admin-titlebar">
      <div>
        <h1>数据概览</h1>
        <p>查看会话、用户、页面浏览、IP 分布和近 14 天访问趋势。</p>
      </div>
    </section>

    <% if (notice) { %>
      <div class="admin-alert admin-alert-ok" role="status"><%= notice %></div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert admin-alert-error" role="alert"><%= error %></div>
    <% } %>

    <section class="admin-dashboard-grid">
      <article class="admin-stat-card"><span>页面浏览</span><strong><%= summary.page_views || 0 %></strong></article>
      <article class="admin-stat-card" title="全站去重，定时聚合"><span>会话数</span><strong><%= summary.sessions || 0 %></strong></article>
      <article class="admin-stat-card" title="按访客 Cookie 去重，含匿名与登录读者"><span>访客数</span><strong><%= summary.users || 0 %></strong></article>
      <article class="admin-stat-card" title="按读者账号去重（Web / App 登录用户）"><span>登录读者</span><strong><%= summary.readers || 0 %></strong></article>
      <article class="admin-stat-card" title="全站去重，定时聚合"><span>IP 数</span><strong><%= summary.unique_ips || 0 %></strong></article>
      <article class="admin-stat-card" title="全站去重，定时聚合"><span>浏览小说</span><strong><%= summary.novels_viewed || 0 %></strong></article>
      <article class="admin-stat-card" title="全站去重，定时聚合"><span>浏览章节</span><strong><%= summary.chapters_viewed || 0 %></strong></article>
    </section>

    <section class="admin-dashboard-layout">
      <section class="admin-block">
        <div class="admin-section-title">
          <h2>近 14 天浏览趋势</h2>
          <span>页面浏览 / 会话 / 访客 / 登录读者 / IP</span>
        </div>
        <div class="admin-trend-chart">
          <% const maxValue = Math.max(1, ...dailySeries.map(function(row) { return Math.max(row.page_views, row.sessions, row.users, row.readers, row.unique_ips); })); %>
          <% dailySeries.forEach(function(row) { %>
            <div class="admin-trend-col">
              <div class="admin-trend-bars">
                <div class="admin-trend-bar page-views" style="height:<%= Math.max(6, row.page_views / maxValue * 100) %>%"></div>
                <div class="admin-trend-bar sessions" style="height:<%= Math.max(6, row.sessions / maxValue * 100) %>%"></div>
                <div class="admin-trend-bar users" style="height:<%= Math.max(6, row.users / maxValue * 100) %>%"></div>
                <div class="admin-trend-bar readers" style="height:<%= Math.max(6, row.readers / maxValue * 100) %>%"></div>
                <div class="admin-trend-bar ips" style="height:<%= Math.max(6, row.unique_ips / maxValue * 100) %>%"></div>
              </div>
              <span><%= row.day.slice(5) %></span>
            </div>
          <% }) %>
        </div>
        <div class="admin-legend">
          <span><i class="page-views"></i>页面浏览</span>
          <span><i class="sessions"></i>会话</span>
          <span><i class="users"></i>访客</span>
          <span><i class="readers"></i>登录读者</span>
          <span><i class="ips"></i>IP</span>
        </div>
      </section>

      <section class="admin-dashboard-side">
        <section class="admin-block">
          <div class="admin-section-title"><h2>热门页面</h2></div>
          <ul class="admin-metric-list">
            <% topPaths.forEach(function(item) { %>
              <li><span><%= item.path %></span><strong><%= item.views %></strong></li>
            <% }) %>
          </ul>
        </section>

        <section class="admin-block">
          <div class="admin-section-title"><h2>热门小说</h2></div>
          <ul class="admin-metric-list">
            <% topNovels.forEach(function(item) { %>
              <li><span><%= item.title %></span><strong><%= item.views %></strong></li>
            <% }) %>
          </ul>
        </section>

        <section class="admin-block">
          <div class="admin-section-title"><h2>热门 IP</h2></div>
          <ul class="admin-metric-list">
            <% topIps.forEach(function(item) { %>
              <li><span><%= item.ip %></span><strong><%= item.views %></strong></li>
            <% }) %>
          </ul>
        </section>
      </section>
    </section>

    <section class="admin-block">
      <div class="admin-section-title">
        <h2>用户访问统计</h2>
        <span>按用户和 IP 汇总，最多显示 50 条</span>
      </div>
      <div class="admin-table-wrap" tabindex="0" role="region" aria-label="访问统计数据表格，可横向滚动">
        <table class="admin-table admin-user-stats-table">
          <caption class="admin-sr-only">按读者、令牌和 IP 汇总的访问统计</caption>
          <thead>
            <tr>
              <th scope="col">读者 / 令牌</th>
              <th scope="col">IP</th>
              <th scope="col">浏览次数</th>
              <th scope="col">会话数</th>
              <th scope="col">路径数</th>
              <th scope="col">小说</th>
              <th scope="col">章节</th>
              <th scope="col">首次访问</th>
              <th scope="col">最近访问</th>
            </tr>
          </thead>
          <tbody>
            <% userIpStats.forEach(function(item) { %>
              <% var who = item.reader_name || item.user_name || ''; %>
              <tr>
                <td class="admin-mono-cell" title="<%= who || item.visitor_uid %>"><%= who || (item.visitor_uid.slice(0, 8) + '…') %></td>
                <td class="admin-mono-cell"><%= item.visitor_ip %></td>
                <td><strong><%= item.page_views %></strong></td>
                <td><%= item.sessions %></td>
                <td><%= item.paths %></td>
                <td><%= item.novels %></td>
                <td><%= item.chapters %></td>
                <td><%= item.first_seen %></td>
                <td><%= item.last_seen %></td>
              </tr>
            <% }) %>
            <% if (userIpStats.length === 0) { %>
              <tr>
                <td colspan="9" class="admin-empty">暂无访问记录</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="admin-block">
      <div class="admin-section-title">
        <h2>最近访问</h2>
        <span>最新 20 条页面浏览</span>
      </div>
      <div class="admin-table-wrap" tabindex="0" role="region" aria-label="访问统计数据表格，可横向滚动">
        <table class="admin-table">
          <caption class="admin-sr-only">最新 20 条页面访问记录</caption>
          <thead>
            <tr>
              <th scope="col">时间</th>
              <th scope="col">路径</th>
              <th scope="col">小说</th>
              <th scope="col">章节</th>
              <th scope="col">IP</th>
              <th scope="col">会话</th>
              <th scope="col">访客</th>
              <th scope="col">读者</th>
            </tr>
          </thead>
          <tbody>
            <% latestViews.forEach(function(item) { %>
              <tr>
                <td><%= item.created_at %></td>
                <td><%= item.path %></td>
                <td><%= item.novel_title || '-' %></td>
                <td><%= item.chapter_title ? ('#' + item.chapter_number + ' ' + item.chapter_title) : '-' %></td>
                <td><%= item.visitor_ip %></td>
                <td><%= item.session_id %></td>
                <td><%= item.visitor_uid.slice(0, 8) + '…' %></td>
                <td><%= item.reader_name || '-' %></td>
              </tr>
            <% }) %>
            <% if (latestViews.length === 0) { %>
              <tr><td colspan="8" class="admin-empty">暂无访问记录</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
