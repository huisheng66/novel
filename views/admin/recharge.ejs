<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>充值码 - 后台管理</title>
  <link rel="stylesheet" href="/css/main.css?v=20261101a">
  <link rel="stylesheet" href="/css/admin.css?v=20261101a">
</head>
<body class="admin-body">
  <%- include('../partials/admin-header', { activePage: 'recharge' }) %>

  <main class="admin-main admin-token-main">
    <section class="admin-titlebar">
      <div>
        <h1>充值码</h1>
        <p>生成、导出和管理一次性钱包充值码。</p>
      </div>
    </section>

    <% if (notice) { %><div class="admin-alert admin-alert-ok" role="status"><%= notice %></div><% } %>
    <% if (error) { %><div class="admin-alert admin-alert-error" role="alert"><%= error %></div><% } %>

    <% if (lastCodes && lastCodes.length) { %>
      <section class="admin-block">
        <div class="admin-section-title"><h2>刚生成的码（请复制发给读者）</h2></div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:0.5rem">
          <% lastCodes.forEach(function(c) { %>
            <li><code style="font-size:1rem;padding:0.35rem 0.6rem;background:var(--code-bg);border-radius:6px;user-select:all"><%= c %></code></li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <section class="admin-block">
      <div class="admin-section-title"><h2>批量生成</h2></div>
      <form class="admin-form" action="/admin/recharge/generate" method="post">
        <div class="admin-grid">
          <label>
            <span>面额（元）</span>
            <input type="number" name="amount" value="10.00" min="0.01" step="0.01" required>
          </label>
          <label>
            <span>数量</span>
            <input type="number" name="count" value="1" min="1" max="100">
          </label>
          <label>
            <span>备注（可选）</span>
            <input type="text" name="note" placeholder="例如：内测第 1 批 / 某读者补单" maxlength="255">
          </label>
          <label>
            <span>有效期（可选）</span>
            <input type="datetime-local" name="expires_at">
          </label>
        </div>
        <button class="button" type="submit">生成充值码</button>
        <p style="color:var(--muted);font-size:0.85rem;margin:0.6rem 0 0">
          新码为 42 位长随机密钥（160 位熵），支持 TXT 导出发给读者。
        </p>
      </form>
    </section>

    <section class="admin-block">
      <div class="admin-section-title">
        <h2>导出 TXT</h2>
        <span>一行一码，可直接发给读者或存档</span>
      </div>
      <div class="admin-title-actions" style="display:flex;gap:0.6rem">
        <a class="button button-secondary" href="/admin/recharge/export.txt?status=unused">导出未使用</a>
        <a class="button button-secondary" href="/admin/recharge/export.txt?status=used">导出已使用</a>
        <a class="button button-secondary" href="/admin/recharge/export.txt?status=expired">导出已过期</a>
      </div>
    </section>

    <section class="admin-block">
      <div class="admin-section-title">
        <h2>列表（共 <%= total %>）</h2>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
          <a class="button button-secondary" href="/admin/recharge?status=unused">未使用</a>
          <a class="button button-secondary" href="/admin/recharge?status=used">已使用</a>
          <a class="button button-secondary" href="/admin/recharge?status=expired">已过期</a>
          <a class="button button-secondary" href="/admin/recharge?status=all">全部</a>
        </div>
      </div>

      <div class="admin-table-wrap" tabindex="0" role="region" aria-label="充值码数据表格，可横向滚动">
        <table class="admin-table">
          <caption class="admin-sr-only">充值码面额、状态、使用情况及可执行操作</caption>
          <thead>
            <tr>
              <th scope="col">码</th>
              <th scope="col">面额</th>
              <th scope="col">状态</th>
              <th scope="col">备注</th>
              <th scope="col">创建时间</th>
              <th scope="col">过期时间</th>
              <th scope="col">使用者</th>
              <th scope="col">操作</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function(rc) { %>
              <tr>
                <td class="admin-mono-cell"><code><%= rc.code %></code></td>
                <td>¥<%= (rc.amount / 100).toFixed(2) %></td>
                <td>
                  <% if (rc.status === 'used') { %>已使用
                  <% } else if (rc.status === 'expired') { %>已过期
                  <% } else { %>未使用<% } %>
                </td>
                <td><%= rc.note || '-' %></td>
                <td><%= new Date(rc.createdAt).toLocaleString('zh-CN') %></td>
                <td><%= rc.expiresAt ? new Date(rc.expiresAt).toLocaleString('zh-CN') : '-' %></td>
                <td><%= rc.usedBy || (rc.usedAt ? '已删除用户' : '-') %></td>
                <td>
                  <% if (rc.status === 'unused') { %>
                    <form action="/admin/recharge/<%= rc.id %>/delete" method="post" style="display:inline"
                          onsubmit="return confirm('删除未使用的充值码 <%= rc.code %>？');">
                      <button class="button button-danger" type="submit">删除充值码</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (items.length === 0) { %>
              <tr><td colspan="8" class="admin-empty">当前筛选下暂无充值码</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
