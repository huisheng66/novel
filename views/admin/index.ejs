<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>后台管理</title>
  <link rel="stylesheet" href="/css/main.css?v=20261101a">
  <link rel="stylesheet" href="/css/admin.css?v=20261101a">
</head>
<body class="admin-body">
  <%- include('../partials/admin-header', { activePage: 'chapters' }) %>

  <main class="admin-main">
    <section class="admin-titlebar">
      <div>
        <h1>章节管理</h1>
        <p>选择小说后新增、编辑或批量导入章节。</p>
      </div>
      <% if (currentNovel) { %>
        <a class="button button-secondary" href="/novel/<%= currentNovel.id %>">查看当前小说</a>
      <% } %>
    </section>

    <% if (notice) { %>
      <div class="admin-alert admin-alert-ok" role="status"><%= notice %></div>
    <% } %>
    <% if (error) { %>
      <div class="admin-alert admin-alert-error" role="alert"><%= error %></div>
    <% } %>

    <section class="admin-panel">
      <% if (currentNovel) { %>
          <section class="admin-block admin-novel-switcher">
            <div class="admin-section-title">
              <h2>当前小说</h2>
              <a href="/admin/novels/info">新增小说</a>
            </div>
            <div class="admin-current-novel">
              <div>
                <strong><%= currentNovel.title %></strong>
                <span><%= novelTotalChapters %> 章</span>
              </div>
              <a class="button button-secondary" href="/admin/novels/info?novel_id=<%= currentNovel.id %>">编辑小说信息</a>
            </div>
            <nav class="admin-novel-tabs" aria-label="小说切换">
              <% novels.forEach(function(novel) { %>
                <a class="<%= currentNovel.id === novel.id ? 'is-active' : '' %>" href="/admin?novel_id=<%= novel.id %>">
                  <span><%= novel.title %></span>
                  <small><%= novel.chapter_count %> 章</small>
                </a>
              <% }) %>
            </nav>
          </section>
          <div
            class="admin-chapter-workspace"
            data-admin-chapters
            data-novel-id="<%= currentNovel.id %>"
            data-next-number="<%= nextNumber %>"
            <% if (selectedChapter) { %>data-selected-chapter-id="<%= selectedChapter.id %>"<% } %>
          >
            <section class="admin-block admin-upload-block">
              <div class="admin-section-title">
                <h2>批量上传</h2>
                <span>自动识别章节标题并拆分正文。</span>
              </div>
              <form class="admin-form admin-upload" action="/admin/chapters/upload" method="post" enctype="multipart/form-data" aria-describedby="upload-help" onsubmit="return this.upload_mode.value !== 'replace' || confirm('覆盖导入将删除当前小说的全部章节，且无法撤销。确认继续？');">
                <input type="hidden" name="novel_id" value="<%= currentNovel.id %>">
                <div class="admin-upload-mode" role="radiogroup" aria-label="导入方式">
                  <label>
                    <input type="radio" name="upload_mode" value="append" checked>
                    <span>追加（保留现有章节）</span>
                  </label>
                  <label>
                    <input type="radio" name="upload_mode" value="replace">
                    <span>覆盖（删除现有章节）</span>
                  </label>
                </div>
                <div class="admin-grid">
                  <label>
                    <span>起始章节号</span>
                    <input type="number" name="start_number" min="1" value="<%= nextNumber %>" required>
                  </label>
                  <label>
                    <span>章节文件</span>
                    <input type="file" name="chapter_files" accept=".txt,.docx,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document" multiple required>
                  </label>
                </div>
                <button class="button" type="submit" data-upload-submit>上传导入</button>
              </form>
              <p class="admin-upload-hint" id="upload-help">追加会保留现有章节；<strong>覆盖会先删除当前小说的全部章节。</strong>支持：第一章 标题、第001章 标题、第十回 标题、Chapter 1、1. 标题。</p>
            </section>

            <section class="admin-block admin-chapter-list-block">
              <div class="admin-section-title">
                <h2>章节列表</h2>
                <span><%= novelTotalChapters %> 章</span>
              </div>
              <% if (chapterPage && chapterPage.totalPages > 1) { %>
                <div class="admin-pagination admin-pagination-top">
                  <div class="admin-pagination-meta">
                    <span>第 <%= chapterPage.page %> / <%= chapterPage.totalPages %> 页</span>
                    <span>每页 <%= chapterPage.pageSize %></span>
                  </div>
                  <div class="admin-pagination-actions">
                    <% if (chapterPage.page > 1) { %>
                      <a class="button button-secondary" href="/admin?novel_id=<%= currentNovel.id %>&chapter_page=<%= chapterPage.page - 1 %>&page_size=<%= chapterPage.pageSize %>">上一页</a>
                    <% } else { %>
                      <span class="button button-secondary is-disabled">上一页</span>
                    <% } %>
                    <% if (chapterPage.page < chapterPage.totalPages) { %>
                      <a class="button button-secondary" href="/admin?novel_id=<%= currentNovel.id %>&chapter_page=<%= chapterPage.page + 1 %>&page_size=<%= chapterPage.pageSize %>">下一页</a>
                    <% } else { %>
                      <span class="button button-secondary is-disabled">下一页</span>
                    <% } %>
                  </div>
                </div>
              <% } %>
              <div class="admin-chapter-list" id="chapter-list">
                <% chapters.forEach(function(chapter) { %>
                  <article class="admin-chapter-row <%= selectedChapter && selectedChapter.id === chapter.id ? 'is-active' : '' %>" data-chapter-row data-chapter-id="<%= chapter.id %>">
                    <a class="admin-chapter-link" href="/admin?novel_id=<%= currentNovel.id %>&chapter_id=<%= chapter.id %>&chapter_page=<%= chapterPage.page %>&page_size=<%= chapterPage.pageSize %>#chapter-editor" data-chapter-id="<%= chapter.id %>">
                      <span class="admin-chapter-number"><%= chapter.chapter_number %></span>
                      <span class="admin-chapter-title"><%= chapter.title %></span>
                    </a>
                  </article>
                <% }) %>
                <% if (chapters.length === 0) { %>
                  <p class="admin-empty">暂无章节</p>
                <% } %>
              </div>
              <% if (chapterPage && chapterPage.totalPages > 1) { %>
                <div class="admin-pagination admin-pagination-bottom">
                  <div class="admin-pagination-meta">
                    <span>共 <%= chapterPage.total %> 章</span>
                    <span>第 <%= chapterPage.page %> / <%= chapterPage.totalPages %> 页</span>
                  </div>
                  <div class="admin-pagination-actions">
                    <% if (chapterPage.page > 1) { %>
                      <a class="button button-secondary" href="/admin?novel_id=<%= currentNovel.id %>&chapter_page=<%= chapterPage.page - 1 %>&page_size=<%= chapterPage.pageSize %>">上一页</a>
                    <% } else { %>
                      <span class="button button-secondary is-disabled">上一页</span>
                    <% } %>
                    <% if (chapterPage.page < chapterPage.totalPages) { %>
                      <a class="button button-secondary" href="/admin?novel_id=<%= currentNovel.id %>&chapter_page=<%= chapterPage.page + 1 %>&page_size=<%= chapterPage.pageSize %>">下一页</a>
                    <% } else { %>
                      <span class="button button-secondary is-disabled">下一页</span>
                    <% } %>
                  </div>
                </div>
              <% } %>
            </section>

            <section class="admin-block admin-chapter-editor-block" id="chapter-editor" data-chapter-editor>
              <div class="admin-section-title">
                <h2><%= selectedChapter ? '章节管理' : '新增章节' %></h2>
                <% if (selectedChapter) { %>
                  <a href="/admin?novel_id=<%= currentNovel.id %>#chapter-editor">新建章节</a>
                <% } else { %>
                  <span>管理单章节的新建、修改、删除。</span>
                <% } %>
              </div>
              <p class="admin-async-status" data-chapter-status role="status" aria-live="polite" aria-atomic="true"></p>
              <form class="admin-form admin-inline-chapter-form" action="<%= selectedChapter ? '/admin/chapters/' + selectedChapter.id : '/admin/chapters' %>" method="post">
                <input type="hidden" name="novel_id" value="<%= currentNovel.id %>">
                <div class="admin-grid">
                  <label>
                    <span>章节编号</span>
                    <input type="number" name="chapter_number" min="1" value="<%= selectedChapter ? selectedChapter.chapter_number : nextNumber %>" required>
                  </label>
                  <label>
                    <span>章节标题</span>
                    <input type="text" name="title" value="<%= selectedChapter ? selectedChapter.title : '' %>" required>
                  </label>
                </div>
                <label>
                  <span>正文内容</span>
                  <textarea name="content" rows="18" required><%= selectedChapter ? selectedChapter.content : '' %></textarea>
                </label>
                <div class="admin-actions">
                  <button class="button" type="submit"><%= selectedChapter ? '保存章节' : '创建章节' %></button>
                  <% if (selectedChapter) { %>
                    <button class="button button-danger admin-delete-selected-chapter" type="submit" form="delete-selected-chapter">删除章节</button>
                    <a class="button button-secondary" href="/novel/<%= currentNovel.id %>/<%= selectedChapter.chapter_number %>">查看前台</a>
                  <% } %>
                </div>
              </form>
              <% if (selectedChapter) { %>
                <form id="delete-selected-chapter" action="/admin/chapters/<%= selectedChapter.id %>/delete" method="post" onsubmit="return confirm('确认删除该章节？');">
                  <input type="hidden" name="novel_id" value="<%= currentNovel.id %>">
                </form>
              <% } %>
            </section>
          </div>
      <% } else { %>
        <section class="admin-block">
          <h2>先创建一本小说</h2>
          <p class="admin-muted">创建小说后即可新增章节或批量导入文件。</p>
          <a class="button" href="/admin/novels/info">去创建小说</a>
        </section>
      <% } %>
    </section>
  </main>
  <script src="/js/admin.js?v=20261101a" defer></script>
</body>
</html>
