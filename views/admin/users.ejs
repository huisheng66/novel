<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>读者账号 - 后台管理</title>
  <link rel="stylesheet" href="/css/main.css?v=20261101a">
  <link rel="stylesheet" href="/css/admin.css?v=20261101a">
</head>
<body class="admin-body">
  <%- include('../partials/admin-header', { activePage: 'users' }) %>

  <main class="admin-main admin-token-main">
    <section class="admin-titlebar">
      <div>
        <h1>读者账号</h1>
        <p>创建并维护 Web 与 App 共用的读者账号、邮箱验证和余额。</p>
      </div>
    </section>

    <% if (notice) { %><div class="admin-alert admin-alert-ok" role="status"><%= notice %></div><% } %>
    <% if (error) { %><div class="admin-alert admin-alert-error" role="alert"><%= error %></div><% } %>

    <section class="admin-block">
      <div class="admin-section-title">
        <h2>新建账号</h2>
        <span>用户名 3–32 位字母数字下划线；密码至少 8 位</span>
      </div>
      <form class="admin-form" action="/admin/users" method="post">
        <div class="admin-grid">
          <label>
            <span>用户名</span>
            <input type="text" name="username" required pattern="[A-Za-z0-9_]{3,32}" placeholder="reader01">
          </label>
          <label>
            <span>邮箱（可选）</span>
            <input type="email" name="email" placeholder="reader@example.com">
          </label>
          <label>
            <span>显示名</span>
            <input type="text" name="displayName" placeholder="可选">
          </label>
          <label>
            <span>密码</span>
            <input type="password" name="password" required minlength="8" placeholder="至少 8 位">
          </label>
        </div>
        <button class="button" type="submit">创建用户</button>
      </form>
    </section>

    <section class="admin-block">
      <div class="admin-section-title">
        <h2>用户列表（共 <%= total %>）</h2>
        <form class="admin-search" method="get" action="/admin/users" role="search">
          <label class="admin-sr-only" for="user-search">搜索用户名或显示名</label>
          <input id="user-search" type="search" name="q" value="<%= q || '' %>" placeholder="搜索用户名/显示名">
          <button class="button button-secondary" type="submit">搜索</button>
        </form>
      </div>

      <div class="admin-table-wrap" tabindex="0" role="region" aria-label="用户数据表格，可横向滚动">
        <table class="admin-table">
          <caption class="admin-sr-only">读者账号列表及可执行操作</caption>
          <thead>
            <tr>
              <th scope="col">ID</th>
              <th scope="col">用户名</th>
              <th scope="col">邮箱 / 验证</th>
              <th scope="col">显示名</th>
              <th scope="col">状态</th>
              <th scope="col">余额</th>
              <th scope="col">创建时间</th>
              <th scope="col">操作</th>
            </tr>
          </thead>
          <tbody>
            <% if (!users || users.length === 0) { %>
              <tr><td colspan="8" class="admin-empty">暂无符合条件的用户</td></tr>
            <% } %>
            <% (users || []).forEach(function(u) { %>
              <tr>
                <td><%= u.id %></td>
                <td><code><%= u.username %></code></td>
                <td>
                  <% if (u.email) { %>
                    <span class="admin-mono-cell"><%= u.email %></span>
                    <br>
                    <% if (u.emailVerified) { %>
                      <span class="admin-status admin-status-ok">已验证</span>
                    <% } else { %>
                      <span class="admin-status admin-status-error">未验证</span>
                    <% } %>
                  <% } else { %>
                    <span class="admin-muted">—</span>
                  <% } %>
                </td>
                <td><%= u.displayName %></td>
                <td><%= u.isActive ? '启用' : '禁用' %></td>
                <td>¥<%= ((u.balance || 0) / 100).toFixed(2) %></td>
                <td><%= u.createdAt %></td>
                <td class="admin-actions-cell">
                  <form action="/admin/users/<%= u.id %>/toggle" method="post" style="display:inline">
                    <input type="hidden" name="is_active" value="<%= u.isActive ? '0' : '1' %>">
                    <button type="submit" class="button button-secondary"><%= u.isActive ? '禁用' : '启用' %></button>
                  </form>
                  <% if (u.email && !u.emailVerified) { %>
                  <form action="/admin/users/<%= u.id %>/verify-email" method="post" style="display:inline"
                        onsubmit="return confirm('手动标记该账号邮箱已验证？');">
                    <button type="submit" class="button button-secondary">标记已验证</button>
                  </form>
                  <% } %>
                  <form action="/admin/users/<%= u.id %>/credit" method="post" style="display:inline" onsubmit="var v=prompt('调整金额（元，负数表示扣减）：', '10'); if(v===null) return false; this.amount.value=v;">
                    <input type="hidden" name="amount" value="">
                    <input type="hidden" name="note" value="后台调整">
                    <button type="submit" class="button button-secondary">充值</button>
                  </form>
                  <form action="/admin/users/<%= u.id %>/revoke-sessions" method="post" style="display:inline">
                    <button type="submit" class="button button-secondary">踢下线</button>
                  </form>
                  <form action="/admin/users/<%= u.id %>/password" method="post" style="display:inline" onsubmit="var p=prompt('新密码（至少8位）'); if(!p||p.length<8){alert('密码至少8位');return false;} this.password.value=p;">
                    <input type="hidden" name="password" value="">
                    <button type="submit" class="button button-secondary">重置密码</button>
                  </form>
                  <form action="/admin/users/<%= u.id %>/delete" method="post" style="display:inline" onsubmit="return confirm('确定删除用户 <%= u.username %>？书架与进度将一并删除。');">
                    <button type="submit" class="button button-danger">删除用户</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% var totalPages = Math.max(1, Math.ceil(total / pageSize)); %>
      <% if (totalPages > 1) { %>
        <p style="margin-top:1rem;font-size:0.85rem;color:var(--muted)">
          第 <%= page %> / <%= totalPages %> 页
          <% if (page > 1) { %>
            <a href="/admin/users?page=<%= page - 1 %>&q=<%= encodeURIComponent(q || '') %>">上一页</a>
          <% } %>
          <% if (page < totalPages) { %>
            <a href="/admin/users?page=<%= page + 1 %>&q=<%= encodeURIComponent(q || '') %>">下一页</a>
          <% } %>
        </p>
      <% } %>
    </section>
  </main>
</body>
</html>
