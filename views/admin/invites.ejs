<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>邀请码 - 后台管理</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css?v=20260809i">
</head>
<body class="admin-body">
  <header id="site-header" class="admin-header">
    <div class="header-inner admin-header-inner">
      <div>
        <a href="/" class="site-name">阅读前台</a>
        <span class="breadcrumb"> / </span>
        <span class="breadcrumb-current">邀请码</span>
      </div>
      <form action="/admin/logout" method="post">
        <button type="submit">退出登录</button>
      </form>
    </div>
  </header>

  <main class="admin-main admin-token-main">
    <section class="admin-titlebar">
      <div>
        <h1>邀请码（一次一码）</h1>
        <p>自助注册（Web / App）必须填写未使用的邀请码；每个码只能注册成功一次。后台直接建号不需要邀请码。</p>
      </div>
      <div class="admin-title-actions">
        <a class="button button-secondary" href="/admin/users">读者账号</a>
        <a class="button button-secondary" href="/admin">章节管理</a>
        <a class="button button-secondary" href="/admin/tokens">Token 用户</a>
      </div>
    </section>

    <% if (notice) { %><div class="admin-alert admin-alert-ok"><%= notice %></div><% } %>
    <% if (error) { %><div class="admin-alert admin-alert-error"><%= error %></div><% } %>

    <% if (lastCodes && lastCodes.length) { %>
      <section class="admin-block">
        <div class="admin-section-title"><h2>刚生成的码（请复制发给用户）</h2></div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:0.5rem">
          <% lastCodes.forEach(function(c) { %>
            <li><code style="font-size:1rem;padding:0.35rem 0.6rem;background:var(--code-bg);border-radius:6px;user-select:all"><%= c %></code></li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <section class="admin-block">
      <div class="admin-section-title">
        <h2>一键生成</h2>
      </div>
      <form class="admin-form" action="/admin/invites/generate" method="post">
        <div class="admin-grid">
          <label>
            <span>数量</span>
            <input type="number" name="count" value="1" min="1" max="50">
          </label>
          <label>
            <span>备注（可选）</span>
            <input type="text" name="note" placeholder="例如：给某某 / 内测第 3 批" maxlength="255">
          </label>
        </div>
        <button class="button" type="submit">生成邀请码</button>
      </form>
    </section>

    <section class="admin-block">
      <div class="admin-section-title">
        <h2>列表（共 <%= total %>）</h2>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
          <a class="button button-secondary" href="/admin/invites?status=unused">未使用</a>
          <a class="button button-secondary" href="/admin/invites?status=used">已使用</a>
          <a class="button button-secondary" href="/admin/invites?status=expired">已过期</a>
          <a class="button button-secondary" href="/admin/invites?status=all">全部</a>
        </div>
      </div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>码</th>
              <th>状态</th>
              <th>备注</th>
              <th>创建时间</th>
              <th>使用时间</th>
              <th>使用者 ID</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (!invites || !invites.length) { %>
              <tr><td colspan="7">暂无</td></tr>
            <% } %>
            <% (invites || []).forEach(function(inv) { %>
              <tr>
                <td><code style="user-select:all"><%= inv.code %></code></td>
                <td><%= inv.status === 'unused' ? '未使用' : inv.status === 'used' ? '已使用' : '已过期' %></td>
                <td><%= inv.note || '—' %></td>
                <td><%= inv.createdAt %></td>
                <td><%= inv.usedAt || '—' %></td>
                <td><%= inv.usedByUserId || '—' %></td>
                <td>
                  <% if (inv.status === 'unused') { %>
                    <form action="/admin/invites/<%= inv.id %>/delete" method="post" style="display:inline" onsubmit="return confirm('删除未使用码 <%= inv.code %>？');">
                      <button type="submit" class="button button-secondary">删除</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
