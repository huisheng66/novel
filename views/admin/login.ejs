<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理员登录</title>
  <link rel="stylesheet" href="/css/main.css?v=20261101a">
  <link rel="stylesheet" href="/css/admin.css?v=20261101a">
</head>
<body class="admin-body">
  <main class="admin-login-main">
    <section class="admin-login-panel">
      <h1>管理员登录</h1>
      <p class="admin-login-intro">输入管理员密码进入后台管理。</p>
      <% if (error) { %>
        <div class="admin-alert admin-alert-error" role="alert"><%= error %></div>
      <% } %>
      <form class="admin-form" action="/admin/login" method="post">
        <input type="hidden" name="next" value="<%= nextPath %>">
        <label>
          <span>密码</span>
          <input type="password" name="password" autocomplete="current-password" autofocus required>
        </label>
        <button class="button" type="submit">登录</button>
      </form>
      <a class="admin-login-back" href="/">返回前台</a>
    </section>
  </main>
</body>
</html>
